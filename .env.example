# lyness 环境变量样例 —— 复制为 .env 后按需改值。
#
#   cp .env.example .env
#
# .env 只属于当前机器，被 .gitignore 排除；本文件纳入版本管理，是"有哪些键可配"
# 的唯一清单。新增一个从环境读取的配置项时，同时在这里补一行。
#
# 读取顺序（高者胜出，见 packages/credentials/credentials-local）：
#
#   继承而来的进程环境           只读，最高
#   > $LYNESS_HOME/.credentials.yaml  产品自己管理，可写
#   > <启动目录>/.env            只读兜底 ← 本文件复制后的位置
#   > $LYNESS_HOME/.env          只读兜底
#
# 所以 `DEEPSEEK_API_KEY=xxx pnpm lyn ...` 这种一次性写法永远压过 .env；
# 而"模型设置"页面写入的密钥压过 .env，不会被仓库里的旧值顶掉。
#
# 下面所有键都是可选的：整份文件留空，产品走各自的默认值。


# ─────────────────────────────────────────────────────────────
# 模型平台
# ─────────────────────────────────────────────────────────────

# 调用大模型的密钥。真实 API 的 e2e（pnpm run test:e2e）和 pnpm lyn 都读它；
# 不设则 e2e 自行跳过。
DEEPSEEK_API_KEY=sk-your-key-here

# 接口地址。不设 = 官方 https://api.deepseek.com。
# 换第三方平台时改这里，代码一行不用动。
# DEEPSEEK_BASE_URL=https://gateway.example.com/v1

# 该平台上的模型 id，逗号分隔，第一个是 e2e 主用模型。
# 不设 = 使用 llm-deepseek 内置的官方模型目录。
# 它替换的是"组合层"的模型目录，仍低于用户在设置页面里的选择。
# DEEPSEEK_MODELS=deepseek-v4.1-flash,deepseek-v4.1

# 联网搜索能力的接口地址，不设则走搜索 provider 自己的默认值。
# DEEPSEEK_SEARCH_BASE_URL=https://api.deepseek.com


# ─────────────────────────────────────────────────────────────
# 运行时目录
# ─────────────────────────────────────────────────────────────

# harness 家目录：会话、凭据、profile、插件都落在这里。默认 ~/.lyn。
# 留空或只有空白视作未设置。
# LYNESS_HOME=/Users/me/.lyn

# 跨 agent 共享的配置根（AGENTS.md、技能等）。默认 ~/.agents。
# LYNESS_AGENTS_HOME=/Users/me/.agents

# 随产品分发的技能目录；只在启用默认技能根时生效，不设则不挂载内置技能。
# LYNESS_BUNDLED_SKILL_DIR=/opt/lyness/skills


# ─────────────────────────────────────────────────────────────
# 运行时行为
# ─────────────────────────────────────────────────────────────

# 置任意非空值即关闭会话遥测上报。CI 一律置 1，避免打到生产端点。
# LYNESS_TELEMETRY_DISABLED=1

# 指定 web 能力用哪个 provider，等价于在 cordis.yml 里写 searchProvider /
# fetchProvider；不设则由组合里装载的 provider 决定。
# LYNESS_WEB_SEARCH_PROVIDER=deepseek
# LYNESS_WEB_FETCH_PROVIDER=deepseek


# ─────────────────────────────────────────────────────────────
# 测试与门禁（本地跑 pnpm run test:* 时才需要）
# ─────────────────────────────────────────────────────────────

# 示例程序从哪份产物启动：src 走 tsx 直跑源码（开发默认），lib 走 tsc 产物 +
# 纯 Node（CI 用这个，贴近真实使用者）。填别的值会直接报错，不会静默回退。
# LYNESS_EXAMPLE_MODE=lib

# e2e 并发文件数，默认 4。撞上平台限流就调成 1 变串行。
# LYNESS_E2E_MAX_WORKERS=1

# 覆盖率门禁的 worker 数与单测超时（毫秒）。机器弱就调小。
# LYNESS_COVERAGE_MAX_WORKERS=4
# LYNESS_COVERAGE_TEST_TIMEOUT_MS=120000

# 把覆盖率拆成 N 份跑第几份，用于 CI 分片；本地一般不用。
# LYNESS_COVERAGE_PARTITIONS=2
# LYNESS_COVERAGE_PARTITION_MODE=1

# 门禁聚合器：并发数、第一个失败就停、以及打印通过项的详细输出。
# LYNESS_GATE_CONCURRENCY=4
# LYNESS_GATE_FAIL_FAST=1
# LYNESS_GATE_VERBOSE=1
