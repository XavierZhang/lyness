# Copy to production.env in the same machine configuration directory and fill in the values.
LYNESS_DESKTOP_APP_ID=com.deepseek.lyn
LYNESS_DESKTOP_AUTO_UPDATE_ENV=production
LYNESS_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN=
LYNESS_DESKTOP_MANDATORY_UPDATE_CONFIG='{}'
# LYNESS_DESKTOP_WINDOWS_SIGNATURE_CACHE_DIR=
LYNESS_DESKTOP_WINDOWS_SIGNATURE_CACHE_CONCURRENCY=4
# Installer archive compression (0-9).
LYNESS_DESKTOP_WINDOWS_COMPRESSION_LEVEL=3
