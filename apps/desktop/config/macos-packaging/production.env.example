# Copy to production.env and configure the production service before selecting this preset.
LYNESS_DESKTOP_APP_ID=com.deepseek.lyn
LYNESS_DESKTOP_AUTO_UPDATE_ENV=production
LYNESS_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN=
LYNESS_DESKTOP_MACOS_PACK_CONCURRENCY=4
LYNESS_DESKTOP_MACOS_ZIP_COMPRESSION_LEVEL=3
LYNESS_DESKTOP_MACOS_DOWNLOAD_PROXY=
LYNESS_DESKTOP_MACOS_NOTARIZATION_PROXY=
# Optional absolute private directory; setup fills this in for machine presets. Omit to use checkout-local storage.
# LYNESS_DESKTOP_MACOS_SIGNATURE_CACHE_DIR=
