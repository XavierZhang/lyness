{
  "name": "@lyness/lyn-web-frontend",
  "description": "Web application entry: vite build over the @lyness/lyn-client-web shell library; dist/ served by apps/cli's lyn web",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "apps/web"
  },
  "type": "module",
  "exports": {
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/preview.html",
    "!dist/preview"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "watch": "vite build --watch --no-emptyOutDir",
    "build:preview": "pnpm --filter @lyness/lyn-experimental-webworker-runtime exec tsdown && pnpm --filter @lyness/lyn-experimental-webworker-packer exec tsdown && vite build && lyn-pack-vfs-image --out dist/preview/vfs-image.tar.gz",
    "serve:preview": "http-server dist -a 0.0.0.0 -p 4173 -c-1",
    "render:app-icons": "tsx scripts/render-app-icons.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@lyness/cordis-plugin-group": "workspace:~",
    "@lyness/lyn-client-modules": "workspace:*",
    "@lyness/lyn-client-store": "workspace:*",
    "@lyness/lyn-client-test-runtime": "workspace:*",
    "@lyness/lyn-client-ui-deliverables": "workspace:*",
    "@lyness/lyn-client-ui-dockkit": "workspace:*",
    "@lyness/lyn-client-ui-primitives": "workspace:*",
    "@lyness/lyn-client-ui-slots": "workspace:*",
    "@lyness/lyn-client-ui-theme": "workspace:*",
    "@lyness/lyn-client-web": "workspace:*",
    "@lyness/lyn-cmdline": "workspace:*",
    "@lyness/lyn-e2e-target": "workspace:*",
    "@lyness/lyn-experimental-agent-team": "workspace:*",
    "@lyness/lyn-experimental-auto-review": "workspace:*",
    "@lyness/lyn-experimental-cot-translation-bundle": "workspace:*",
    "@lyness/lyn-experimental-plugin-market-bundle": "workspace:*",
    "@lyness/lyn-experimental-speech-to-text": "workspace:*",
    "@lyness/lyn-experimental-voice-input-bundle": "workspace:*",
    "@lyness/lyn-experimental-webworker-packer": "workspace:*",
    "@lyness/lyn-experimental-webworker-runtime": "workspace:*",
    "@lyness/lyn-experimental-worktree": "workspace:*",
    "@lyness/lyn-llm-mock-server": "workspace:*",
    "@lyness/lyn-module-memory": "workspace:*",
    "@lyness/lyn-module-schedule": "workspace:*",
    "@lyness/lyn-pwsh-local": "workspace:*",
    "@lyness/lyn-remote-mock": "workspace:*",
    "@lyness/lyn-session-projection-cache": "workspace:*",
    "@lyness/lyn-tool-testkit": "workspace:*",
    "@lyness/lyn-util-values": "workspace:*",
    "@types/node": "^22.20.1",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "fflate": "^0.8.2",
    "http-server": "^14.1.1",
    "playwright": "^1.49.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sharp": "0.35.5",
    "typescript": "^6.0.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11",
    "ws": "8.21.3"
  },
  "dependencies": {
    "@lyness/lyn-launch-environment": "workspace:*",
    "@lyness/lyn-message-quotes": "workspace:*",
    "@lyness/lyn-module-deliverables": "workspace:*",
    "@lyness/lyn-module-extensions": "workspace:*",
    "@lyness/lyn-module-lsp": "workspace:*",
    "@lyness/lyn-module-model-governance": "workspace:*",
    "@lyness/lyn-module-terminal": "workspace:*",
    "@lyness/lyn-module-webhook": "workspace:*",
    "@lyness/lyn-subprocess-local": "workspace:*",
    "@lyness/lyn-workspace-changes": "workspace:*",
    "ws": "8.21.0"
  }
}
