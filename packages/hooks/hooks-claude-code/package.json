{
  "name": "@lyness/hooks-claude-code",
  "description": "Bridge plugin: run a Claude Code hooks.json / settings hook config on the lyness interception seams",
  "version": "0.1.2-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/hooks/hooks-claude-code"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@lyness/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@lyness/agent": "workspace:^",
    "@lyness/hook-protocol": "workspace:^",
    "@lyness/invariants": "workspace:^",
    "@lyness/llm": "workspace:^",
    "@lyness/session": "workspace:^",
    "@lyness/session-persistence": "workspace:^",
    "@lyness/subagent": "workspace:^",
    "@lyness/tools": "workspace:^",
    "@lyness/cordis": "workspace:^"
  },
  "devDependencies": {
    "@lyness/agent": "workspace:^",
    "@lyness/agent-loop": "workspace:^",
    "@lyness/agent-loop-testkit": "workspace:^",
    "@lyness/shell": "workspace:^",
    "@lyness/bash-local": "workspace:^",
    "@lyness/subprocess-local": "workspace:^",
    "@lyness/hook-protocol": "workspace:^",
    "@lyness/invariants": "workspace:^",
    "@lyness/llm": "workspace:^",
    "@lyness/session": "workspace:^",
    "@lyness/session-persistence": "workspace:^",
    "@lyness/session-persistence-jsonl": "workspace:^",
    "@lyness/subagent": "workspace:^",
    "@lyness/tools": "workspace:^",
    "@lyness/cordis": "workspace:^"
  }
}
