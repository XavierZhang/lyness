{
  "name": "@lyness/lyn-lsp",
  "description": "Abstract LSP capability seam (ctx.lsp) for the lyness \u2014 language-server provider registry keyed by branded id and extension mapping, order-independent per-query selection, normalized definition/references/implementation/hover requests and results, and the LspError taxonomy",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/lsp/lsp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./preset-contribution": {
      "types": "./lib/types/preset-contribution.d.ts",
      "default": "./lib/types/preset-contribution.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@lyness/lyn-brand": "workspace:*",
    "@lyness/lyn-llm": "workspace:*",
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-agent-preset-registry": "workspace:*"
  },
  "devDependencies": {
    "@lyness/lyn-brand": "workspace:*",
    "@lyness/lyn-llm": "workspace:*",
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-agent-preset-registry": "workspace:*"
  },
  "dependencies": {
    "@lyness/schemastery": "workspace:~"
  }
}
