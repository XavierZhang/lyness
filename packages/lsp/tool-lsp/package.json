{
  "name": "@lyness/tool-lsp",
  "description": "Model-facing lsp tool over the lyness LSP capability seam (ctx.lsp) — one read-only tool with goToDefinition/findReferences/goToImplementation/hover operations, one-based UTF-16 cursor coordinates, bounded location rendering, and hover normalization",
  "version": "0.1.2-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/lsp/tool-lsp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@lyness/invariants": "workspace:^",
    "@lyness/llm": "workspace:^",
    "@lyness/lsp": "workspace:^",
    "@lyness/system-prompt": "workspace:^",
    "@lyness/timeout": "workspace:^",
    "@lyness/tools": "workspace:^",
    "@lyness/cordis": "workspace:^"
  },
  "dependencies": {
    "@lyness/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@lyness/agent": "workspace:^",
    "@lyness/fs-local": "workspace:^",
    "@lyness/invariants": "workspace:^",
    "@lyness/llm": "workspace:^",
    "@lyness/lsp": "workspace:^",
    "@lyness/lsp-stdio": "workspace:^",
    "@lyness/session": "workspace:^",
    "@lyness/subprocess-local": "workspace:^",
    "@lyness/system-prompt": "workspace:^",
    "@lyness/timeout": "workspace:^",
    "@lyness/tool-call-timeout-policy": "workspace:^",
    "@lyness/tools": "workspace:^",
    "@lyness/cordis": "workspace:^"
  }
}
