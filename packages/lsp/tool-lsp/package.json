{
  "name": "@lyness/lyn-tool-lsp",
  "description": "Model-facing lsp tool over the lyness LSP capability seam (ctx.lsp) — one read-only tool with goToDefinition/findReferences/goToImplementation/hover operations, one-based UTF-16 cursor coordinates, bounded location rendering, and hover normalization",
  "version": "0.1.5-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/lsp/tool-lsp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@lyness/cordis": "workspace:^",
    "@lyness/lyn-llm": "workspace:^",
    "@lyness/lyn-lsp": "workspace:^",
    "@lyness/lyn-system-prompt": "workspace:^",
    "@lyness/lyn-timeout": "workspace:^",
    "@lyness/lyn-tools": "workspace:^"
  },
  "dependencies": {
    "@lyness/lyn-util-values": "workspace:^",
    "@lyness/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:^",
    "@lyness/lyn-agent": "workspace:^",
    "@lyness/lyn-fs-local": "workspace:^",
    "@lyness/lyn-llm": "workspace:^",
    "@lyness/lyn-lsp": "workspace:^",
    "@lyness/lyn-lsp-stdio": "workspace:^",
    "@lyness/lyn-session": "workspace:^",
    "@lyness/lyn-subprocess-local": "workspace:^",
    "@lyness/lyn-system-prompt": "workspace:^",
    "@lyness/lyn-timeout": "workspace:^",
    "@lyness/lyn-tool-call-timeout-policy": "workspace:^",
    "@lyness/lyn-tools": "workspace:^"
  }
}
