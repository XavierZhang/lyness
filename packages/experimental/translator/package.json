{
  "name": "@lyness/lyn-experimental-translator",
  "description": "Machine translation with reusable Session results",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/experimental/translator"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@lyness/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/cordis-plugin-loader": "workspace:~",
    "@lyness/lyn-credentials": "workspace:*",
    "@lyness/lyn-launch-environment": "workspace:*",
    "@lyness/lyn-llm": "workspace:*",
    "@lyness/lyn-session": "workspace:*",
    "@lyness/lyn-session-persistence": "workspace:*",
    "@lyness/lyn-timeout": "workspace:*",
    "@lyness/lyn-util-values": "workspace:*"
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/cordis-plugin-loader": "workspace:~",
    "@lyness/lyn-app-boot": "workspace:*",
    "@lyness/lyn-credentials": "workspace:*",
    "@lyness/lyn-deepseek-account": "workspace:*",
    "@lyness/lyn-deepseek-llm-api-extensions": "workspace:*",
    "@lyness/lyn-launch-environment": "workspace:*",
    "@lyness/lyn-llm": "workspace:*",
    "@lyness/lyn-llm-deepseek": "workspace:*",
    "@lyness/lyn-llm-deepseek-account": "workspace:*",
    "@lyness/lyn-llm-deepseek-api-key": "workspace:*",
    "@lyness/lyn-session": "workspace:*",
    "@lyness/lyn-session-log-deepseek": "workspace:*",
    "@lyness/lyn-session-persistence": "workspace:*",
    "@lyness/lyn-session-persistence-jsonl": "workspace:*",
    "@lyness/lyn-session-query-sqlite": "workspace:*",
    "@lyness/lyn-timeout": "workspace:*",
    "@lyness/lyn-util-values": "workspace:*"
  }
}
