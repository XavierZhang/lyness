{
  "name": "@lyness/lyn-personalized-recommendations",
  "description": "Personalized pages and built-in plugin recommendations offered as cards below answers",
  "version": "0.2.1-rc.3",
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/experimental/personalized-recommendations"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "docs",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@lyness/lyn-action-cards": "workspace:*",
    "@lyness/lyn-client-ui-action-cards": "workspace:*",
    "@lyness/lyn-client-ui-creation-recommendations": "workspace:*",
    "@lyness/lyn-client-ui-plugin-recommendations": "workspace:*",
    "@lyness/lyn-creation-recommendations": "workspace:*",
    "@lyness/lyn-plugin-recommendations": "workspace:*"
  },
  "peerDependencies": {
    "@lyness/cordis": "workspace:~"
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/cordis-plugin-include": "workspace:~",
    "@lyness/cordis-plugin-timer": "workspace:~",
    "@lyness/lyn-agent": "workspace:*",
    "@lyness/lyn-api-remote-access": "workspace:*",
    "@lyness/lyn-app-boot": "workspace:*",
    "@lyness/lyn-hmr": "workspace:*",
    "@lyness/lyn-llm": "workspace:*",
    "@lyness/lyn-plugin-manager": "workspace:*",
    "@lyness/lyn-session": "workspace:*",
    "@lyness/lyn-session-projection": "workspace:*",
    "@lyness/lyn-skill": "workspace:*",
    "@lyness/lyn-system-prompt": "workspace:*",
    "@lyness/lyn-tool-executor-native": "workspace:*",
    "@lyness/lyn-tools": "workspace:*",
    "js-yaml": "^4.3.2"
  },
  "lyn": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
