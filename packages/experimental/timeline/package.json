{
  "name": "@lyness/lyn-timeline",
  "description": "Replace Todo in long-running sessions with task trees, a live progress bar, and timed reports",
  "version": "0.2.2-rc.3",
  "icon": "./icon.svg",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/experimental/timeline"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "docs",
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "lyn": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@lyness/lyn-client-connection",
        "@lyness/lyn-client-locale",
        "@lyness/lyn-client-ui-conversation",
        "@lyness/lyn-client-ui-plugin-manager",
        "@lyness/lyn-client-ui-renderer",
        "@lyness/lyn-client-ui-session",
        "@lyness/lyn-client-ui-settings",
        "@lyness/lyn-client-ui-sidebar-right",
        "@lyness/lyn-client-ui-tool",
        "@lyness/lyn-api-session-controller"
      ]
    }
  },
  "dependencies": {
    "@lyness/lyn-llm": "workspace:*",
    "@lyness/lyn-util-crypto": "workspace:*",
    "@lyness/schemastery": "workspace:~",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-error": "workspace:*",
    "@lyness/lyn-scope": "workspace:*",
    "@lyness/lyn-session": "workspace:*",
    "@lyness/lyn-tools": "workspace:*"
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/cordis-plugin-loader": "workspace:~",
    "@lyness/cosmokit": "workspace:~",
    "@lyness/lyn-agent": "workspace:*",
    "@lyness/lyn-agent-loop-testkit": "workspace:*",
    "@lyness/lyn-api-session-controller": "workspace:*",
    "@lyness/lyn-client-connection": "workspace:*",
    "@lyness/lyn-client-locale": "workspace:*",
    "@lyness/lyn-client-store": "workspace:*",
    "@lyness/lyn-client-ui-commands": "workspace:*",
    "@lyness/lyn-client-ui-conversation": "workspace:*",
    "@lyness/lyn-client-ui-plugin-manager": "workspace:*",
    "@lyness/lyn-client-ui-primitives": "workspace:*",
    "@lyness/lyn-client-ui-renderer": "workspace:*",
    "@lyness/lyn-client-ui-session": "workspace:*",
    "@lyness/lyn-client-ui-settings": "workspace:*",
    "@lyness/lyn-client-ui-sidebar-right": "workspace:*",
    "@lyness/lyn-client-ui-slots": "workspace:*",
    "@lyness/lyn-client-ui-tool": "workspace:*",
    "@lyness/lyn-commands": "workspace:*",
    "@lyness/lyn-error": "workspace:*",
    "@lyness/lyn-fs": "workspace:*",
    "@lyness/lyn-fs-local": "workspace:*",
    "@lyness/lyn-scope": "workspace:*",
    "@lyness/lyn-session": "workspace:*",
    "@lyness/lyn-session-persistence": "workspace:*",
    "@lyness/lyn-session-persistence-jsonl": "workspace:*",
    "@lyness/lyn-session-projection": "workspace:*",
    "@lyness/lyn-session-title": "workspace:*",
    "@lyness/lyn-settings": "workspace:*",
    "@lyness/lyn-system-prompt": "workspace:*",
    "@lyness/lyn-tools": "workspace:*",
    "@testing-library/react": "^16.1.0",
    "@types/d3-time": "^3.0.4",
    "d3-time": "3.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  }
}
