{
  "name": "@lyness/lyn-experimental-claude-code-mods",
  "description": "Experimental bridge: load Claude Code mods (hooks modules) and run their hook chains on lyness extension points",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/experimental/claude-code-mods"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./testing": {
      "types": "./lib/types/testing.d.ts",
      "default": "./lib/types/testing.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./examples/*": "./examples/*",
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@lyness/lyn-util-crypto": "workspace:*",
    "@lyness/lyn-util-values": "workspace:*",
    "@lyness/schemastery": "workspace:~",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-agent": "workspace:*",
    "@lyness/lyn-commands": "workspace:*",
    "@lyness/lyn-fs": "workspace:*",
    "@lyness/lyn-llm": "workspace:*",
    "@lyness/lyn-scope": "workspace:*",
    "@lyness/lyn-session": "workspace:*",
    "@lyness/lyn-storage-domain": "workspace:*",
    "@lyness/lyn-subprocess": "workspace:*",
    "@lyness/lyn-token-meter": "workspace:*",
    "@lyness/lyn-tools": "workspace:*",
    "@lyness/lyn-typert-protocol": "workspace:*",
    "@lyness/lyn-user-questions": "workspace:*",
    "@lyness/lyn-working-directory": "workspace:*"
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/cordis-plugin-include": "workspace:~",
    "@lyness/cordis-plugin-loader": "workspace:~",
    "@lyness/lyn-agent": "workspace:*",
    "@lyness/lyn-agent-loop": "workspace:*",
    "@lyness/lyn-agent-loop-testkit": "workspace:*",
    "@lyness/lyn-attachment": "workspace:*",
    "@lyness/lyn-commands": "workspace:*",
    "@lyness/lyn-fs": "workspace:*",
    "@lyness/lyn-fs-local": "workspace:*",
    "@lyness/lyn-llm": "workspace:*",
    "@lyness/lyn-scope": "workspace:*",
    "@lyness/lyn-session": "workspace:*",
    "@lyness/lyn-session-persistence-jsonl": "workspace:*",
    "@lyness/lyn-session-projection": "workspace:*",
    "@lyness/lyn-storage": "workspace:*",
    "@lyness/lyn-storage-domain": "workspace:*",
    "@lyness/lyn-storage-json": "workspace:*",
    "@lyness/lyn-subprocess": "workspace:*",
    "@lyness/lyn-subprocess-local": "workspace:*",
    "@lyness/lyn-system-prompt": "workspace:*",
    "@lyness/lyn-token-meter": "workspace:*",
    "@lyness/lyn-tool-executor-native": "workspace:*",
    "@lyness/lyn-tool-testkit": "workspace:*",
    "@lyness/lyn-tools": "workspace:*",
    "@lyness/lyn-typert-protocol": "workspace:*",
    "@lyness/lyn-user-questions": "workspace:*",
    "@lyness/lyn-working-directory": "workspace:*"
  }
}
