{
  "name": "@lyness/lyn-experimental-client-ui-forge",
  "description": "Sidebar panel for a Session's change requests, with a worktree option for new Sessions and its Host Remote",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/experimental/client-ui-forge"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./types": {
      "types": "./lib/types/types.d.ts"
    }
  },
  "lyn": {
    "client": {
      "inject": [
        "@lyness/lyn-api-remotes",
        "@lyness/lyn-client-locale",
        "@lyness/lyn-client-ui-conversation",
        "@lyness/lyn-client-ui-layout",
        "@lyness/lyn-client-ui-plugin-manager",
        "@lyness/lyn-client-ui-settings",
        "@lyness/lyn-client-ui-sidebar-right",
        "@lyness/lyn-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-experimental-worktree": "workspace:*",
    "@lyness/lyn-session": "workspace:*",
    "@lyness/lyn-timeout": "workspace:*",
    "@lyness/lyn-experimental-forge": "workspace:*",
    "@lyness/lyn-fs": "workspace:*"
  },
  "dependencies": {
    "@lyness/schemastery": "workspace:~",
    "@lyness/lyn-util-values": "workspace:*",
    "diff": "^9.0.0",
    "zod": "4.6.6",
    "@lyness/lyn-typert-protocol": "workspace:*",
    "@lyness/lyn-storage-domain": "workspace:*",
    "picomatch": "^4.0.7"
  },
  "devDependencies": {
    "@lyness/lyn-brand": "workspace:*",
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-agent": "workspace:*",
    "@lyness/lyn-agent-loop-testkit": "workspace:*",
    "@lyness/lyn-api-remotes": "workspace:*",
    "@lyness/lyn-api-session-controller": "workspace:*",
    "@lyness/lyn-client-locale": "workspace:*",
    "@lyness/lyn-client-store": "workspace:*",
    "@lyness/lyn-client-test-runtime": "workspace:*",
    "@lyness/lyn-client-ui-conversation": "workspace:*",
    "@lyness/lyn-client-ui-layout": "workspace:*",
    "@lyness/lyn-client-ui-plugin-manager": "workspace:*",
    "@lyness/lyn-client-ui-primitives": "workspace:*",
    "@lyness/lyn-client-ui-renderer": "workspace:*",
    "@lyness/lyn-client-ui-session": "workspace:*",
    "@lyness/lyn-client-ui-settings": "workspace:*",
    "@lyness/lyn-client-ui-sidebar-right": "workspace:*",
    "@lyness/lyn-client-ui-slots": "workspace:*",
    "@lyness/lyn-client-ui-workspace": "workspace:*",
    "@lyness/lyn-experimental-forge": "workspace:*",
    "@lyness/lyn-experimental-forge-session": "workspace:*",
    "@lyness/lyn-experimental-worktree": "workspace:*",
    "@lyness/lyn-fs": "workspace:*",
    "@lyness/lyn-fs-local": "workspace:*",
    "@lyness/lyn-llm": "workspace:*",
    "@lyness/lyn-sandbox": "workspace:*",
    "@lyness/lyn-sandbox-local": "workspace:*",
    "@lyness/lyn-sandbox-policy": "workspace:*",
    "@lyness/lyn-session": "workspace:*",
    "@lyness/lyn-session-projection": "workspace:*",
    "@lyness/lyn-subprocess": "workspace:*",
    "@lyness/lyn-subprocess-local": "workspace:*",
    "@lyness/lyn-system-prompt": "workspace:*",
    "@lyness/lyn-util-workspace-path": "workspace:*",
    "@lyness/lyn-working-directory": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "clsx": "^2.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@lyness/lyn-timeout": "workspace:*",
    "@lyness/lyn-session-projection-cache": "workspace:*",
    "@lyness/lyn-session-query": "workspace:*",
    "@lyness/lyn-api-remote-access": "workspace:*",
    "@types/picomatch": "^4.0.3",
    "@lyness/lyn-brand": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/typert.remote-client.d.ts.map",
    "src"
  ]
}
