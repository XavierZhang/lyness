{
  "name": "@lyness/lyn-experimental-cua-macos",
  "description": "macOS native provider for shared Computer Use application and window objects",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/experimental/cua-macos"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "native/bin",
    "native/Package.swift",
    "native/Sources",
    "native/tests/swift",
    "native/tests/test_swift.py",
    "native/LICENSE.cua-driver",
    "native/upstream.json",
    "native/README.md",
    "native/README.zh.md",
    "native/protocol.schema.json",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-agent": "workspace:*",
    "@lyness/lyn-computer-use": "workspace:*",
    "@lyness/lyn-subprocess": "workspace:*",
    "@lyness/lyn-system-prompt": "workspace:*",
    "@lyness/lyn-tools": "workspace:*",
    "@lyness/lyn-user-questions": "workspace:*"
  },
  "dependencies": {
    "@lyness/lyn-atomic-write": "workspace:*",
    "@lyness/lyn-cua": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/cordis-plugin-include": "workspace:~",
    "@lyness/cordis-plugin-loader": "workspace:~",
    "@lyness/cordis-plugin-timer": "workspace:~",
    "@lyness/lyn-agent": "workspace:*",
    "@lyness/lyn-agent-loop": "workspace:*",
    "@lyness/lyn-agent-loop-testkit": "workspace:*",
    "@lyness/lyn-app-boot": "workspace:*",
    "@lyness/lyn-attachment": "workspace:*",
    "@lyness/lyn-attachment-local": "workspace:*",
    "@lyness/lyn-computer-use": "workspace:*",
    "@lyness/lyn-config-editor": "workspace:*",
    "@lyness/lyn-fs-local": "workspace:*",
    "@lyness/lyn-hmr": "workspace:*",
    "@lyness/lyn-llm": "workspace:*",
    "@lyness/lyn-llm-deepseek": "workspace:*",
    "@lyness/lyn-ptc-runtime": "workspace:*",
    "@lyness/lyn-ptc-runtime-node": "workspace:*",
    "@lyness/lyn-sandbox-local": "workspace:*",
    "@lyness/lyn-sandbox-policy": "workspace:*",
    "@lyness/lyn-session": "workspace:*",
    "@lyness/lyn-session-projection": "workspace:*",
    "@lyness/lyn-settings": "workspace:*",
    "@lyness/lyn-subprocess": "workspace:*",
    "@lyness/lyn-subprocess-local": "workspace:*",
    "@lyness/lyn-system-prompt": "workspace:*",
    "@lyness/lyn-tool-executor-native": "workspace:*",
    "@lyness/lyn-tool-executor-ptc": "workspace:*",
    "@lyness/lyn-tool-testkit": "workspace:*",
    "@lyness/lyn-tools": "workspace:*",
    "@lyness/lyn-user-questions": "workspace:*",
    "@lyness/lyn-working-directory": "workspace:*",
    "sharp": "^0.35.3"
  },
  "scripts": {
    "build:native": "swift build --package-path native --configuration release"
  },
  "os": [
    "darwin"
  ]
}
