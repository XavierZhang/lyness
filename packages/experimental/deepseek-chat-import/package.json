{
  "name": "@lyness/lyn-deepseek-chat-import",
  "description": "Import DeepSeek chat exports as stored Sessions in a chosen Workspace",
  "version": "0.2.2-rc.3",
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/experimental/deepseek-chat-import"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "docs",
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/typert.remote-client.d.ts.map",
    "src"
  ],
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "@lyness/lyn-brand": "workspace:*",
    "@lyness/lyn-typert-protocol": "workspace:*",
    "@lyness/schemastery": "workspace:~",
    "fflate": "^0.8.2",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-session": "workspace:*",
    "@lyness/lyn-session-title": "workspace:*",
    "@lyness/lyn-tool-web": "workspace:*"
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/cordis-plugin-include": "workspace:~",
    "@lyness/cordis-plugin-loader": "workspace:~",
    "@lyness/lyn-agent": "workspace:*",
    "@lyness/lyn-agent-loop-testkit": "workspace:*",
    "@lyness/lyn-api-remote-access": "workspace:*",
    "@lyness/lyn-api-session-controller": "workspace:*",
    "@lyness/lyn-api-workspace-controller": "workspace:*",
    "@lyness/lyn-attachment": "workspace:*",
    "@lyness/lyn-client-connection": "workspace:*",
    "@lyness/lyn-client-locale": "workspace:*",
    "@lyness/lyn-client-test-runtime": "workspace:*",
    "@lyness/lyn-client-ui-conversation": "workspace:*",
    "@lyness/lyn-client-ui-primitives": "workspace:*",
    "@lyness/lyn-client-ui-renderer": "workspace:*",
    "@lyness/lyn-client-ui-sidebar": "workspace:*",
    "@lyness/lyn-client-ui-slots": "workspace:*",
    "@lyness/lyn-client-ui-workspace": "workspace:*",
    "@lyness/lyn-llm": "workspace:*",
    "@lyness/lyn-session": "workspace:*",
    "@lyness/lyn-session-persistence": "workspace:*",
    "@lyness/lyn-session-persistence-jsonl": "workspace:*",
    "@lyness/lyn-session-projection": "workspace:*",
    "@lyness/lyn-session-projection-cache": "workspace:*",
    "@lyness/lyn-session-title": "workspace:*",
    "@lyness/lyn-storage": "workspace:*",
    "@lyness/lyn-storage-domain": "workspace:*",
    "@lyness/lyn-storage-json": "workspace:*",
    "@lyness/lyn-tool-web": "workspace:*",
    "@lyness/lyn-typert-registry": "workspace:*",
    "@lyness/lyn-util-values": "workspace:*",
    "@lyness/lyn-web": "workspace:*",
    "@lyness/lyn-workspace": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "clsx": "^2.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "lyn": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@lyness/lyn-api-remote-access",
        "@lyness/lyn-api-session-controller",
        "@lyness/lyn-client-locale",
        "@lyness/lyn-client-ui-renderer",
        "@lyness/lyn-client-ui-sidebar",
        "@lyness/lyn-client-ui-workspace"
      ],
      "platform": "web"
    }
  }
}
