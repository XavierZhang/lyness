{
  "name": "@lyness/lyn-cua-mcp",
  "description": "Computer Use as an MCP stdio server: a lyn profile bundle that exposes cua_run_code to external agent harnesses",
  "version": "0.2.2-rc.3",
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/experimental/cua-mcp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "lyn": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-attachment": "workspace:*",
    "@lyness/lyn-app-boot": "workspace:*"
  },
  "dependencies": {
    "@lyness/lyn-agent": "workspace:*",
    "@lyness/lyn-agent-loop": "workspace:*",
    "@lyness/lyn-agent-preset": "workspace:*",
    "@lyness/lyn-agent-preset-registry": "workspace:*",
    "@lyness/lyn-attachment-local": "workspace:*",
    "@lyness/lyn-brand": "workspace:*",
    "@lyness/lyn-cmdline": "workspace:*",
    "@lyness/lyn-computer-use": "workspace:*",
    "@lyness/lyn-cua": "workspace:*",
    "@lyness/lyn-fs-sandbox": "workspace:*",
    "@lyness/lyn-llm": "workspace:*",
    "@lyness/lyn-sandbox-local": "workspace:*",
    "@lyness/lyn-sandbox-policy": "workspace:*",
    "@lyness/lyn-session": "workspace:*",
    "@lyness/lyn-session-persistence-jsonl": "workspace:*",
    "@lyness/lyn-session-projection": "workspace:*",
    "@lyness/lyn-storage": "workspace:*",
    "@lyness/lyn-storage-domain": "workspace:*",
    "@lyness/lyn-storage-json": "workspace:*",
    "@lyness/lyn-subprocess-local": "workspace:*",
    "@lyness/lyn-system-prompt": "workspace:*",
    "@lyness/lyn-tool-executor-native": "workspace:*",
    "@lyness/lyn-tools": "workspace:*",
    "@lyness/lyn-user-approval": "workspace:*",
    "@lyness/lyn-user-questions": "workspace:*",
    "@lyness/lyn-working-directory": "workspace:*",
    "@lyness/schemastery": "workspace:~",
    "@modelcontextprotocol/server": "2.2.0",
    "commander": "^15.0.0"
  },
  "optionalDependencies": {
    "@lyness/lyn-cua-macos": "workspace:*",
    "@lyness/lyn-cua-windows": "workspace:*"
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/cordis-plugin-include": "workspace:~",
    "@lyness/cordis-plugin-loader": "workspace:~",
    "@lyness/lyn-app-boot": "workspace:*",
    "@lyness/lyn-attachment": "workspace:*",
    "@lyness/lyn-fs-local": "workspace:*",
    "@lyness/lyn-ptc-runtime-node": "workspace:*",
    "@modelcontextprotocol/client": "2.2.0"
  }
}
