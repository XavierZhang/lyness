{
  "name": "@lyness/lyn-experimental-forge-github",
  "description": "GitHub provider for the experimental forge registry, read through the GitHub CLI on the host",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/experimental/forge-github"
  },
  "dependencies": {
    "@lyness/schemastery": "workspace:~",
    "@lyness/lyn-timeout": "workspace:*",
    "execa": "^10.0.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-experimental-forge": "workspace:*",
    "@lyness/lyn-subprocess": "workspace:*"
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-brand": "workspace:*",
    "@lyness/lyn-experimental-forge": "workspace:*",
    "@lyness/lyn-subprocess": "workspace:*"
  }
}
