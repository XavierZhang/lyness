{
  "name": "@lyness/lyn-experimental-terminal-bundle",
  "description": "Let the agent run long-lived commands in terminals you can watch in the sidebar.",
  "version": "0.2.2-rc.3",
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/experimental/terminal-bundle"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "docs",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "lyn": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@lyness/lyn-tool-terminal": "workspace:*",
    "@lyness/lyn-terminal": "workspace:*",
    "@lyness/lyn-terminal-panel": "workspace:*"
  },
  "peerDependencies": {
    "@lyness/cordis": "workspace:~"
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:~"
  }
}
