{
  "name": "@lyness/lyn-experimental-webworker-packer",
  "description": "Build-time packer for the browser runtime's base VFS image and ordered data-overlay archives",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/experimental/webworker-packer"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "bin": {
    "lyn-pack-vfs-image": "./bin.js"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/bin.js",
    "bin.js",
    "lib/repository-*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@lyness/cordis-plugin-include": "workspace:~",
    "@lyness/lyn-app-boot": "workspace:*",
    "@lyness/lyn-experimental-webworker-runtime": "workspace:*",
    "@lyness/lyn-official-bundles": "workspace:*",
    "@lyness/lyn-session-format": "workspace:*",
    "@lyness/lyn-session-format-catalog": "workspace:*",
    "@lyness/lyn-session-format-v3-to-v4": "workspace:*",
    "picomatch": "^4.0.7"
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:~",
    "@types/picomatch": "^4.0.3"
  },
  "peerDependencies": {
    "@lyness/cordis": "workspace:~"
  }
}
