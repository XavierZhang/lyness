{
  "name": "@lyness/lyn-cua-windows",
  "description": "Windows C# computer use through shared application and window objects",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/experimental/cua-windows"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "peerDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-computer-use": "workspace:*",
    "@lyness/lyn-system-prompt": "workspace:*",
    "@lyness/lyn-tools": "workspace:*",
    "@lyness/lyn-agent": "workspace:*",
    "@lyness/lyn-subprocess": "workspace:*",
    "@lyness/lyn-user-questions": "workspace:*"
  },
  "dependencies": {
    "zod": "4.6.6",
    "@lyness/lyn-cua": "workspace:*",
    "@lyness/schemastery": "workspace:~",
    "@lyness/lyn-native-command": "workspace:*",
    "@lyness/lyn-atomic-write": "workspace:*"
  },
  "devDependencies": {
    "@lyness/lyn-brand": "workspace:*",
    "@lyness/lyn-working-directory": "workspace:*",
    "@lyness/cordis": "workspace:~",
    "@lyness/cordis-plugin-include": "workspace:~",
    "@lyness/cordis-plugin-loader": "workspace:~",
    "@lyness/lyn-agent": "workspace:*",
    "@lyness/lyn-agent-loop": "workspace:*",
    "@lyness/lyn-agent-loop-testkit": "workspace:*",
    "@lyness/lyn-attachment": "workspace:*",
    "@lyness/lyn-attachment-local": "workspace:*",
    "@lyness/lyn-computer-use": "workspace:*",
    "@lyness/lyn-llm": "workspace:*",
    "@lyness/lyn-session": "workspace:*",
    "@lyness/lyn-session-projection": "workspace:*",
    "@lyness/lyn-system-prompt": "workspace:*",
    "@lyness/lyn-tools": "workspace:*",
    "@lyness/lyn-subprocess": "workspace:*",
    "@lyness/lyn-subprocess-local": "workspace:*",
    "@lyness/lyn-fs-local": "workspace:*",
    "@lyness/lyn-llm-deepseek": "workspace:*",
    "@lyness/lyn-ptc-runtime-node": "workspace:*",
    "@lyness/lyn-sandbox-local": "workspace:*",
    "@lyness/lyn-sandbox-policy": "workspace:*",
    "sharp": "^0.35.3",
    "@lyness/lyn-ptc-runtime": "workspace:*",
    "@lyness/lyn-user-questions": "workspace:*",
    "@lyness/lyn-settings": "workspace:*",
    "@lyness/lyn-app-boot": "workspace:*",
    "@lyness/lyn-config-editor": "workspace:*",
    "@lyness/lyn-hmr": "workspace:*",
    "@lyness/cordis-plugin-timer": "workspace:~"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "native/bin",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "scripts": {
    "build:native": "dotnet publish native/entry/CuaWindows.csproj --configuration Release --self-contained false --output native/bin/local -p:EnableWindowsTargeting=true",
    "build:native:x64": "dotnet publish native/entry/CuaWindows.csproj --configuration Release --runtime win-x64 --self-contained true --output native/bin/win-x64 -p:EnableWindowsTargeting=true",
    "build:native:arm64": "dotnet publish native/entry/CuaWindows.csproj --configuration Release --runtime win-arm64 --self-contained true --output native/bin/win-arm64 -p:EnableWindowsTargeting=true"
  },
  "os": [
    "win32",
    "linux"
  ]
}
