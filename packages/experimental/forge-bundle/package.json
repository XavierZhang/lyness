{
  "name": "@lyness/lyn-experimental-forge-bundle",
  "description": "Experimental change request panel and worktree option for Sessions in Git repositories",
  "version": "0.2.2-alpha.3",
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/experimental/forge-bundle"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "docs",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@lyness/lyn-experimental-client-ui-forge": "workspace:*",
    "@lyness/lyn-experimental-forge": "workspace:*",
    "@lyness/lyn-experimental-forge-github": "workspace:*",
    "@lyness/lyn-experimental-forge-session": "workspace:*",
    "@lyness/lyn-experimental-tool-worktree": "workspace:*",
    "@lyness/lyn-experimental-worktree": "workspace:*"
  },
  "peerDependencies": {
    "@lyness/cordis": "workspace:~"
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:~"
  },
  "lyn": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
