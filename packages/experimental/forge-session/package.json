    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts"
    },
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/experimental/forge-session"
  },
  "dependencies": {
    "@lyness/lyn-timeout": "workspace:*",
    "@lyness/lyn-util-values": "workspace:*",
    "@lyness/schemastery": "workspace:~",
    "shell-quote": "^1.12.0",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-llm": "workspace:*",
    "@lyness/lyn-experimental-forge": "workspace:*",
    "@lyness/lyn-session": "workspace:*",
    "@lyness/lyn-session-projection": "workspace:*",
    "@lyness/lyn-shell": "workspace:*",
    "@lyness/lyn-shell-env": "workspace:*",
    "@lyness/lyn-tools": "workspace:*",
    "@lyness/lyn-sandbox-policy": "workspace:*"
  },
  "devDependencies": {
    "@lyness/lyn-brand": "workspace:*",
    "@lyness/cordis": "workspace:~",
    "@lyness/cordis-plugin-include": "workspace:~",
    "@lyness/cordis-plugin-loader": "workspace:~",
    "@lyness/lyn-agent": "workspace:*",
    "@lyness/lyn-agent-loop": "workspace:*",
    "@lyness/lyn-bash-local": "workspace:*",
    "@lyness/lyn-experimental-forge": "workspace:*",
    "@lyness/lyn-experimental-forge-github": "workspace:*",
    "@lyness/lyn-fs-local": "workspace:*",
    "@lyness/lyn-llm": "workspace:*",
    "@lyness/lyn-session": "workspace:*",
