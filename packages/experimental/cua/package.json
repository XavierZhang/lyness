{
  "name": "@lyness/lyn-cua",
  "description": "Shared Computer Use application objects, authorization, and logged tool execution",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/experimental/cua"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./api": {
      "types": "./lib/types/api.d.ts",
      "default": "./lib/api.js"
    },
    "./bridge": {
      "types": "./lib/types/bridge.d.ts",
      "default": "./lib/bridge.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./types": {
      "types": "./lib/types/remote-types.d.ts",
      "default": "./lib/remote-types.js"
    },
    "./native-client": {
      "types": "./lib/types/native-client.d.ts",
      "default": "./lib/native-client.js"
    },
    "./protocol": {
      "types": "./lib/types/protocol.d.ts",
      "default": "./lib/protocol.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    }
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/remote-types.js",
    "lib/api.js",
    "lib/bridge.js",
    "lib/native-client.js",
    "lib/protocol.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-attachment": "workspace:*",
    "@lyness/lyn-scope": "workspace:*",
    "@lyness/lyn-user-questions": "workspace:*"
  },
  "dependencies": {
    "@lyness/lyn-atomic-write": "workspace:*",
    "@lyness/lyn-computer-use": "workspace:*",
    "@lyness/lyn-typert-protocol": "workspace:*",
    "@lyness/schemastery": "workspace:~",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/cordis-plugin-include": "workspace:~",
    "@lyness/cordis-plugin-loader": "workspace:~",
    "@lyness/cordis-plugin-timer": "workspace:~",
    "@lyness/lyn-agent": "workspace:*",
    "@lyness/lyn-agent-loop": "workspace:*",
    "@lyness/lyn-agent-loop-testkit": "workspace:*",
    "@lyness/lyn-agent-preset-registry": "workspace:*",
    "@lyness/lyn-api-gateway": "workspace:*",
    "@lyness/lyn-api-remotes": "workspace:*",
    "@lyness/lyn-app-boot": "workspace:*",
    "@lyness/lyn-attachment": "workspace:*",
    "@lyness/lyn-attachment-local": "workspace:*",
    "@lyness/lyn-brand": "workspace:*",
    "@lyness/lyn-client-locale": "workspace:*",
    "@lyness/lyn-client-store": "workspace:*",
    "@lyness/lyn-client-test-runtime": "workspace:*",
    "@lyness/lyn-client-ui-approval": "workspace:*",
    "@lyness/lyn-client-ui-conversation": "workspace:*",
    "@lyness/lyn-client-ui-layout": "workspace:*",
    "@lyness/lyn-client-ui-plugin-manager": "workspace:*",
    "@lyness/lyn-client-ui-primitives": "workspace:*",
    "@lyness/lyn-client-ui-renderer": "workspace:*",
    "@lyness/lyn-client-ui-settings": "workspace:*",
    "@lyness/lyn-client-ui-slots": "workspace:*",
    "@lyness/lyn-client-ui-user-questions": "workspace:*",
    "@lyness/lyn-config-editor": "workspace:*",
    "@lyness/lyn-fs-local": "workspace:*",
    "@lyness/lyn-hmr": "workspace:*",
    "@lyness/lyn-llm": "workspace:*",
    "@lyness/lyn-llm-deepseek": "workspace:*",
    "@lyness/lyn-loader-smoke": "workspace:*",
    "@lyness/lyn-ptc-runtime": "workspace:*",
    "@lyness/lyn-ptc-runtime-node": "workspace:*",
    "@lyness/lyn-sandbox-local": "workspace:*",
    "@lyness/lyn-sandbox-policy": "workspace:*",
    "@lyness/lyn-scope": "workspace:*",
    "@lyness/lyn-session": "workspace:*",
    "@lyness/lyn-session-projection": "workspace:*",
    "@lyness/lyn-settings": "workspace:*",
    "@lyness/lyn-subprocess": "workspace:*",
    "@lyness/lyn-subprocess-local": "workspace:*",
    "@lyness/lyn-system-prompt": "workspace:*",
    "@lyness/lyn-tools": "workspace:*",
    "@lyness/lyn-user-questions": "workspace:*",
    "@lyness/lyn-util-values": "workspace:*",
    "@lyness/lyn-working-directory": "workspace:*",
    "@testing-library/react": "^16.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sharp": "^0.35.3"
  },
  "lyn": {
    "client": {
      "inject": [
        "@lyness/lyn-api-remotes",
        "@lyness/lyn-client-locale",
        "@lyness/lyn-client-ui-plugin-manager",
        "@lyness/lyn-client-ui-settings",
        "@lyness/lyn-client-ui-layout",
        "@lyness/lyn-client-ui-user-questions",
        "@lyness/lyn-client-ui-approval",
        "@lyness/lyn-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  }
}
