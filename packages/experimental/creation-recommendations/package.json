{
  "name": "@lyness/lyn-creation-recommendations",
  "description": "Create persistent removable interface plugins from explicit conversation needs",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/experimental/creation-recommendations"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./references/*.md": "./references/*.md",
    "./skills/*.md": "./skills/*.md"
  },
  "license": "MIT",
  "peerDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-llm": "workspace:*",
    "@lyness/lyn-session": "workspace:*",
    "@lyness/lyn-skill": "workspace:*",
    "@lyness/lyn-tools": "workspace:*"
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-agent": "workspace:*",
    "@lyness/lyn-api-remote-access": "workspace:*",
    "@lyness/lyn-app-boot": "workspace:*",
    "@lyness/lyn-llm": "workspace:*",
    "@lyness/lyn-plugin-manager": "workspace:*",
    "@lyness/lyn-sandbox-policy": "workspace:*",
    "@lyness/lyn-session": "workspace:*",
    "@lyness/lyn-session-projection": "workspace:*",
    "@lyness/lyn-skill": "workspace:*",
    "@lyness/lyn-subagent": "workspace:*",
    "@lyness/lyn-tool-testkit": "workspace:*",
    "@lyness/lyn-tools": "workspace:*"
  },
  "dependencies": {
    "@lyness/lyn-action-cards": "workspace:*",
    "@lyness/lyn-client-ui-action-cards": "workspace:*",
    "@lyness/lyn-client-ui-creation-recommendations": "workspace:*",
    "resolve.exports": "^2.0.3",
    "yaml": "^2.9.0",
    "zod": "4.4.3"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "references/*.md",
    "skills/*.md",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "icon": "./icon.svg"
}
