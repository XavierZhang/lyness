{
  "name": "@lyness/lyn-web-search-exa",
  "description": "Exa-backed search provider for the lyness web capability seam (ctx.web)",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/web/web-search-exa"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-launch-environment": "workspace:*",
    "@lyness/lyn-web": "workspace:*"
  },
  "dependencies": {
    "@lyness/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-http-proxy": "workspace:*",
    "@lyness/lyn-launch-environment": "workspace:*",
    "@lyness/lyn-web": "workspace:*"
  }
}
