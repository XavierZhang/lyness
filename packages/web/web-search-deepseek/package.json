{
  "name": "@lyness/lyn-web-search-deepseek",
  "description": "DeepSeek-backed search provider (native web_search via the Anthropic-compatible API) for the lyness web capability seam (ctx.web)",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/web/web-search-deepseek"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@lyness/lyn-agent": "workspace:*",
    "@lyness/lyn-credentials": "workspace:*",
    "@lyness/lyn-deepseek-account": "workspace:*",
    "@lyness/lyn-launch-environment": "workspace:*",
    "@lyness/lyn-llm-deepseek": "workspace:*",
    "@lyness/lyn-session": "workspace:*",
    "@lyness/lyn-web": "workspace:*",
    "@lyness/cordis": "workspace:~"
  },
  "dependencies": {
    "@lyness/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@lyness/lyn-brand": "workspace:*",
    "@lyness/lyn-agent": "workspace:*",
    "@lyness/lyn-credentials": "workspace:*",
    "@lyness/lyn-credentials-local": "workspace:*",
    "@lyness/lyn-deepseek-account": "workspace:*",
    "@lyness/lyn-launch-environment": "workspace:*",
    "@lyness/lyn-llm-deepseek": "workspace:*",
    "@lyness/lyn-session": "workspace:*",
    "@lyness/lyn-web": "workspace:*",
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-http-proxy": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@lyness/lyn-deepseek-account": {
      "optional": true
    }
  }
}
