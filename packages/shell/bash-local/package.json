{
  "name": "@lyness/lyn-bash-local",
  "description": "Local-subprocess implementation of the lyness bash executor seam",
  "version": "0.1.5-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/shell/bash-local"
  },
