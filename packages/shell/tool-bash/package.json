    "@lyness/lyn-llm": "workspace:*",
    "@lyness/lyn-sandbox": "workspace:*",
    "@lyness/lyn-sandbox-policy": "workspace:*",
    "@lyness/lyn-shell": "workspace:*",
    "@lyness/lyn-shell-env": "workspace:*",
    "@lyness/lyn-system-prompt": "workspace:*",
    "@lyness/lyn-tools": "workspace:*",
    "@lyness/lyn-user-approval": "workspace:*",
    "@lyness/lyn-working-directory": "workspace:*"
  },
  "dependencies": {
    "@lyness/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-agent": "workspace:*",
    "@lyness/lyn-agent-loop": "workspace:*",
    "@lyness/lyn-agent-loop-testkit": "workspace:*",
    "@lyness/lyn-bash-local": "workspace:*",
