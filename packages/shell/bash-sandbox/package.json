{
  "name": "@lyness/lyn-bash-sandbox",
  "description": "Sandbox-consuming implementation of the lyness bash executor seam (confines every command via ctx.sandbox, reports denial/enforcement result facts)",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/shell/bash-sandbox"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-bash-local": "workspace:*",
    "@lyness/lyn-sandbox": "workspace:*",
    "@lyness/lyn-sandbox-policy": "workspace:*",
    "@lyness/lyn-shell": "workspace:*"
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-bash-local": "workspace:*",
    "@lyness/lyn-sandbox": "workspace:*",
    "@lyness/lyn-sandbox-local": "workspace:*",
    "@lyness/lyn-sandbox-policy": "workspace:*",
    "@lyness/lyn-session-projection": "workspace:*",
    "@lyness/lyn-shell": "workspace:*",
    "@lyness/lyn-subprocess-local": "workspace:*",
    "@lyness/node-addon-system": "workspace:~"
  }
}
