{
  "name": "@lyness/lyn-spill-policy",
  "description": "Tool-result spill policy for the lyness — replaces oversized plain-text tool results with a retained preview plus a spill-file path (no service API)",
  "version": "0.1.5-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/spill/spill-policy"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./notice": {
      "types": "./lib/types/notice.d.ts",
      "default": "./lib/types/notice.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@lyness/lyn-llm": "workspace:^",
    "@lyness/lyn-output-retention": "workspace:^",
    "@lyness/lyn-session": "workspace:^",
    "@lyness/lyn-spill": "workspace:^",
    "@lyness/lyn-tools": "workspace:^",
    "@lyness/cordis": "workspace:^"
  },
  "dependencies": {
    "@lyness/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@lyness/lyn-agent": "workspace:^",
    "@lyness/lyn-code-runtime-worker-thread": "workspace:^",
    "@lyness/lyn-llm": "workspace:^",
    "@lyness/lyn-output-retention": "workspace:^",
    "@lyness/lyn-session": "workspace:^",
    "@lyness/lyn-spill": "workspace:^",
    "@lyness/lyn-tools": "workspace:^",
    "@lyness/cordis": "workspace:^"
  }
}
