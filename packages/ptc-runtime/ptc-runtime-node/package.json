{
  "name": "@lyness/lyn-ptc-runtime-node",
  "description": "Node PTC execution with async function, REPL, scoped REPL and VM Script evaluators and optional retained state",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/ptc-runtime/ptc-runtime-node"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./configuration": {
      "types": "./lib/types/configuration.d.ts",
      "default": "./lib/configuration.js"
    },
    "./process": {
      "types": "./lib/types/process-entry.d.ts",
      "default": "./lib/process.js"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/configuration.js",
    "lib/process.js",
    "lib/persistent-process.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-ptc-runtime": "workspace:*",
    "@lyness/lyn-session": "workspace:*",
    "@lyness/lyn-timeout": "workspace:*",
    "@lyness/lyn-fs": "workspace:*",
    "@lyness/lyn-subprocess": "workspace:*",
    "@lyness/lyn-sandbox": "workspace:*",
    "@lyness/lyn-sandbox-policy": "workspace:*"
  },
  "dependencies": {
    "@lyness/lyn-util-values": "workspace:*",
    "@lyness/schemastery": "workspace:~",
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "birpc": "4.2.0"
  },
  "devDependencies": {
    "@lyness/lyn-brand": "workspace:*",
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-ptc-runtime": "workspace:*",
    "@lyness/lyn-session": "workspace:*",
    "@lyness/lyn-timeout": "workspace:*",
    "@lyness/lyn-fs": "workspace:*",
    "@lyness/lyn-subprocess": "workspace:*",
    "@lyness/lyn-sandbox": "workspace:*",
    "@lyness/lyn-sandbox-policy": "workspace:*",
    "@lyness/lyn-fs-local": "workspace:*",
    "@lyness/lyn-subprocess-local": "workspace:*",
    "@lyness/lyn-session-projection": "workspace:*",
    "@lyness/lyn-sandbox-local": "workspace:*",
    "@lyness/lyn-attachment": "workspace:*"
  }
}
