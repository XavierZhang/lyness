{
  "name": "@lyness/lyn-credentials-local",
  "description": "File-backed credentials provider ($LYNESS_HOME/.env under the live process environment) for the lyness",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/credentials/credentials-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-atomic-write": "workspace:*",
    "@lyness/lyn-credentials": "workspace:*",
    "@lyness/lyn-home-paths": "workspace:*",
    "@lyness/lyn-launch-environment": "workspace:*"
  },
  "dependencies": {
    "@lyness/schemastery": "workspace:~",
    "chokidar": "5.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-atomic-write": "workspace:*",
    "@lyness/lyn-credentials": "workspace:*",
    "@lyness/lyn-home-paths": "workspace:*",
    "@lyness/lyn-launch-environment": "workspace:*"
  }
}
