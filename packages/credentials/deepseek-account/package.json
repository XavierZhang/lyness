{
  "name": "@lyness/lyn-deepseek-account",
  "description": "Sign in to DeepSeek and manage account credentials and notifications",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/credentials/deepseek-account"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./client-metadata": {
      "types": "./lib/types/client-metadata.d.ts",
      "default": "./lib/types/client-metadata.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    }
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/typert.remote-client.d.ts.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-brand": "workspace:*",
    "@lyness/lyn-agent": "workspace:*",
    "@lyness/lyn-llm": "workspace:*",
    "@lyness/lyn-util-values": "workspace:*",
    "@lyness/lyn-authorization": "workspace:*",
    "@lyness/lyn-credentials": "workspace:*",
    "@lyness/lyn-host-webserver": "workspace:*",
    "@lyness/lyn-typert-protocol": "workspace:*"
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-client-connection": "workspace:*",
    "@lyness/lyn-brand": "workspace:*",
    "@lyness/lyn-agent": "workspace:*",
    "@lyness/lyn-llm": "workspace:*",
    "@lyness/lyn-util-values": "workspace:*",
    "@lyness/lyn-authorization": "workspace:*",
    "@lyness/lyn-credentials": "workspace:*",
    "@lyness/lyn-host-webserver": "workspace:*",
    "@lyness/lyn-typert-protocol": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@lyness/lyn-agent": {
      "optional": true
    }
  },
  "dependencies": {
    "@lyness/schemastery": "workspace:~",
    "zod": "4.6.6"
  }
}
