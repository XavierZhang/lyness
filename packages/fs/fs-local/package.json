{
  "name": "@lyness/fs-local",
  "description": "Local-filesystem implementation of the lyness filesystem seam (ctx.fs)",
  "version": "0.1.5-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/fs/fs-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@lyness/fs": "workspace:^",
    "@lyness/cordis": "workspace:^"
  },
  "dependencies": {
    "koffi": "^3.1.0",
    "@lyness/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@lyness/fs": "workspace:^",
    "@lyness/llm": "workspace:^",
    "@lyness/cordis": "workspace:^"
  }
}
