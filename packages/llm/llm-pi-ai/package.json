{
  "name": "@lyness/llm-pi-ai",
  "description": "pi-ai-backed DeepSeek adapter for the lyness LLM seam (design-verification twin of lyn-llm-deepseek)",
  "version": "0.1.2-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/llm/llm-pi-ai"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@lyness/attachment": "workspace:^",
    "@lyness/authorization": "workspace:^",
    "@lyness/credentials": "workspace:^",
    "@lyness/fs": "workspace:^",
    "@lyness/launch-environment": "workspace:^",
    "@lyness/invariants": "workspace:^",
    "@lyness/llm": "workspace:^",
    "@lyness/settings": "workspace:^",
    "@lyness/timeout": "workspace:^",
    "@lyness/cordis": "workspace:^"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.84.2",
    "@lyness/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@lyness/attachment": "workspace:^",
    "@lyness/authorization": "workspace:^",
    "@lyness/credentials": "workspace:^",
    "@lyness/fs": "workspace:^",
    "@lyness/launch-environment": "workspace:^",
    "@lyness/invariants": "workspace:^",
    "@lyness/llm": "workspace:^",
    "@lyness/llm-deepseek": "workspace:^",
    "@lyness/settings": "workspace:^",
    "@lyness/timeout": "workspace:^",
    "@lyness/cordis": "workspace:^"
  }
}
