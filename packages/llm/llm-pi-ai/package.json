{
  "name": "@lyness/lyn-llm-pi-ai",
  "description": "pi-ai-backed DeepSeek adapter for the lyness LLM seam (design-verification twin of lyn-llm-deepseek)",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/llm/llm-pi-ai"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/cordis-plugin-loader": "workspace:~",
    "@lyness/lyn-attachment": "workspace:*",
    "@lyness/lyn-authorization": "workspace:*",
    "@lyness/lyn-credentials": "workspace:*",
    "@lyness/lyn-fs": "workspace:*",
    "@lyness/lyn-launch-environment": "workspace:*",
    "@lyness/lyn-llm": "workspace:*",
    "@lyness/lyn-timeout": "workspace:*"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^1.3.0",
    "@lyness/lyn-brand": "workspace:*",
    "@lyness/lyn-util-values": "workspace:*",
    "@lyness/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/cordis-plugin-loader": "workspace:~",
    "@lyness/lyn-agent-loop-testkit": "workspace:*",
    "@lyness/lyn-attachment": "workspace:*",
    "@lyness/lyn-authorization": "workspace:*",
    "@lyness/lyn-credentials": "workspace:*",
    "@lyness/lyn-e2e-target": "workspace:*",
    "@lyness/lyn-fs": "workspace:*",
    "@lyness/lyn-http-proxy": "workspace:*",
    "@lyness/lyn-launch-environment": "workspace:*",
    "@lyness/lyn-llm": "workspace:*",
    "@lyness/lyn-llm-deepseek": "workspace:*",
    "@lyness/lyn-llm-deepseek-api-key": "workspace:*",
    "@lyness/lyn-session": "workspace:*",
    "@lyness/lyn-settings": "workspace:*",
    "@lyness/lyn-timeout": "workspace:*",
    "@lyness/lyn-tool-testkit": "workspace:*",
    "@lyness/lyn-tools": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@lyness/cordis-plugin-loader": {
      "optional": true
    }
  }
}
