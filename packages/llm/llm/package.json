{
  "name": "@lyness/lyn-llm",
  "description": "Provider-neutral LLM service interface for the lyness",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/llm/llm"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./message": {
      "types": "./lib/types/message.d.ts",
      "default": "./lib/types/message.js"
    },
    "./assistant-stream": {
      "types": "./lib/types/assistant-stream.d.ts",
      "default": "./lib/types/assistant-stream.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/typert.remote-client.d.ts.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@lyness/lyn-error": "workspace:*",
    "@lyness/cordis": "workspace:~"
  },
  "dependencies": {
    "@lyness/lyn-util-crypto": "workspace:*",
    "@lyness/schemastery": "workspace:~",
    "zod": "4.6.6",
    "@lyness/lyn-timeout": "workspace:*",
    "@lyness/lyn-brand": "workspace:*",
    "@lyness/lyn-util-values": "workspace:*",
    "@lyness/lyn-typert-protocol": "workspace:*"
  },
  "devDependencies": {
    "@lyness/lyn-attachment": "workspace:*",
    "@lyness/lyn-error": "workspace:*",
    "@lyness/lyn-package-manifest": "workspace:*",
    "@lyness/cordis": "workspace:~"
  }
}
