{
  "name": "@lyness/acp",
  "description": "Automation-only Agent Client Protocol server for driving lyness agents over JSON-RPC stdio",
  "version": "0.1.5-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/acp/acp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@lyness/brand": "workspace:^",
    "@lyness/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@lyness/cordis": "workspace:^",
    "@lyness/agent": "workspace:^",
    "@lyness/attachment": "workspace:^",
    "@lyness/llm": "workspace:^",
    "@lyness/mcp-client": "workspace:^",
    "@lyness/session": "workspace:^",
    "@lyness/session-persistence": "workspace:^",
    "@lyness/token-meter": "workspace:^",
    "@lyness/user-approval": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@lyness/token-meter": {
      "optional": true
    }
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:^",
    "@lyness/agent": "workspace:^",
    "@lyness/agent-loop": "workspace:^",
    "@lyness/agent-loop-testkit": "workspace:^",
    "@lyness/attachment": "workspace:^",
    "@lyness/llm": "workspace:^",
    "@lyness/mcp-client": "workspace:^",
    "@lyness/session": "workspace:^",
    "@lyness/session-persistence": "workspace:^",
    "@lyness/session-persistence-jsonl": "workspace:^",
    "@lyness/session-projection": "workspace:^",
    "@lyness/token-meter": "workspace:^",
    "@lyness/tools": "workspace:^",
    "@lyness/user-approval": "workspace:^"
  }
}
