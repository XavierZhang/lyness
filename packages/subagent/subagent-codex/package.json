      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@lyness/cordis": "workspace:^",
    "@lyness/llm": "workspace:^",
    "@lyness/session": "workspace:^",
    "@lyness/subagent": "workspace:^",
    "@lyness/subprocess": "workspace:^",
    "@lyness/timeout": "workspace:^"
  },
  "dependencies": {
    "@lyness/brand": "workspace:^",
    "@lyness/sdk-protocol": "workspace:^",
    "@lyness/schemastery": "workspace:^",
    "@openai/codex": "0.153.4"
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:^",
    "@lyness/cordis-plugin-loader": "workspace:^",
    "@lyness/agent": "workspace:^",
    "@lyness/app-boot": "workspace:^",
    "@lyness/llm": "workspace:^",
    "@lyness/loader-smoke": "workspace:^",
    "@lyness/session": "workspace:^",
    "@lyness/session-checkpoint-policy": "workspace:^",
    "@lyness/session-persistence-jsonl": "workspace:^",
    "@lyness/session-projection": "workspace:^",
    "@lyness/subagent": "workspace:^",
    "@lyness/subprocess": "workspace:^",
    "@lyness/subprocess-local": "workspace:^",
    "@lyness/timeout": "workspace:^",
    "@lyness/tool-jobs": "workspace:^",
    "@lyness/tool-subagent": "workspace:^",
    "@lyness/tools": "workspace:^"
  }
