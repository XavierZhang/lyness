{
  "name": "@lyness/lyn-tool-subagent",
  "description": "Model-facing subagent delegation tool over the ctx.subagents seam",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/subagent/tool-subagent"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./model-selection-settings": {
      "types": "./lib/types/model-selection-settings.d.ts",
      "default": "./lib/model-selection-settings.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./model-selection-settings/locale/*.json": "./locale/model-selection-settings/*.json"
  },
  "files": [
    "locale/*.json",
    "locale/model-selection-settings/*.json",
    "lib/index.js",
    "lib/model-selection-settings.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@lyness/lyn-agent": "workspace:*",
    "@lyness/lyn-agent-preset-registry": "workspace:*",
    "@lyness/lyn-llm": "workspace:*",
    "@lyness/lyn-session": "workspace:*",
    "@lyness/lyn-session-projection": "workspace:*",
    "@lyness/lyn-subagent": "workspace:*",
    "@lyness/lyn-system-prompt": "workspace:*",
    "@lyness/lyn-tools": "workspace:*",
    "@lyness/cordis": "workspace:~"
  },
  "peerDependenciesMeta": {
    "@lyness/lyn-agent-preset-registry": {
      "optional": true
    }
  },
  "dependencies": {
    "@lyness/lyn-brand": "workspace:*",
    "@lyness/schemastery": "workspace:~",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@lyness/cordis-plugin-loader": "workspace:~",
    "@lyness/lyn-agent": "workspace:*",
    "@lyness/lyn-agent-preset-registry": "workspace:*",
    "@lyness/lyn-llm": "workspace:*",
    "@lyness/lyn-session": "workspace:*",
    "@lyness/lyn-session-persistence": "workspace:*",
    "@lyness/lyn-session-persistence-jsonl": "workspace:*",
    "@lyness/lyn-subagent": "workspace:*",
    "@lyness/lyn-subagent-spawn-in-process": "workspace:*",
    "@lyness/lyn-system-prompt": "workspace:*",
    "@lyness/lyn-tool-executor-native": "workspace:*",
    "@lyness/lyn-tool-testkit": "workspace:*",
    "@lyness/lyn-tools": "workspace:*",
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-session-projection": "workspace:*"
  }
}
