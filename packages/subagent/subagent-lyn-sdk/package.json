{
  "name": "@lyness/subagent-lyn-sdk",
  "description": "Out-of-process SDK subagent backend: drives a child lyness runtime subprocess over stdio JSON-RPC through the TypeScript SDK client",
  "version": "0.1.2-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/subagent/subagent-lyn-sdk"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@lyness/agent": "workspace:^",
    "@lyness/invariants": "workspace:^",
    "@lyness/llm": "workspace:^",
    "@lyness/sdk-client": "workspace:^",
    "@lyness/session": "workspace:^",
    "@lyness/subagent": "workspace:^",
    "@lyness/subprocess": "workspace:^",
    "@lyness/cordis": "workspace:^"
  },
  "dependencies": {
    "@lyness/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@lyness/cordis-plugin-loader": "workspace:^",
    "@lyness/agent": "workspace:^",
    "@lyness/agent-instructions": "workspace:^",
    "@lyness/agent-spine-demo": "workspace:^",
    "@lyness/app-boot": "workspace:^",
    "@lyness/invariants": "workspace:^",
    "@lyness/llm": "workspace:^",
    "@lyness/llm-deepseek": "workspace:^",
    "@lyness/loader-smoke": "workspace:^",
    "@lyness/sdk-client": "workspace:^",
    "@lyness/sdk-protocol": "workspace:^",
    "@lyness/session": "workspace:^",
    "@lyness/session-checkpoint-policy": "workspace:^",
    "@lyness/session-persistence-jsonl": "workspace:^",
    "@lyness/skill-filesystem": "workspace:^",
    "@lyness/subagent": "workspace:^",
    "@lyness/subprocess": "workspace:^",
    "@lyness/system-prompt": "workspace:^",
    "@lyness/tool-subagent": "workspace:^",
    "@lyness/cordis": "workspace:^"
  }
}
