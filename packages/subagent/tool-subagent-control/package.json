{
  "name": "@lyness/tool-subagent-control",
  "description": "Globally named send_message, interrupt_agent, and list_agents tools over ctx.subagents continuations",
  "version": "0.1.5-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/subagent/tool-subagent-control"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./list-agents": {
      "types": "./lib/types/list-agents.d.ts",
      "default": "./lib/types/list-agents.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@lyness/cordis": "workspace:^",
    "@lyness/llm": "workspace:^",
    "@lyness/session": "workspace:^",
    "@lyness/subagent": "workspace:^",
    "@lyness/tools": "workspace:^"
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:^",
    "@lyness/agent": "workspace:^",
    "@lyness/agent-loop": "workspace:^",
    "@lyness/agent-loop-testkit": "workspace:^",
    "@lyness/llm": "workspace:^",
    "@lyness/session": "workspace:^",
    "@lyness/session-persistence": "workspace:^",
    "@lyness/session-persistence-jsonl": "workspace:^",
    "@lyness/session-projection": "workspace:^",
    "@lyness/session-query": "workspace:^",
    "@lyness/subagent": "workspace:^",
    "@lyness/subagent-fork-in-process": "workspace:^",
    "@lyness/subagent-spawn-in-process": "workspace:^",
    "@lyness/tools": "workspace:^"
  },
  "dependencies": {
    "@lyness/brand": "workspace:^",
    "@lyness/util-values": "workspace:^"
  }
}
