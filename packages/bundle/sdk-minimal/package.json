{
  "name": "@lyness/lyn-sdk-minimal",
  "description": "The standalone minimal SDK profile bundle: JSON-RPC, one DeepSeek adapter, persistent shell, and JSONL sessions",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/bundle/sdk-minimal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "lyn": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@lyness/cordis-plugin-timer": "workspace:~",
    "@lyness/lyn-agent": "workspace:*",
    "@lyness/lyn-agent-loop": "workspace:*",
    "@lyness/lyn-attachment-local": "workspace:*",
    "@lyness/lyn-compaction-basic": "workspace:*",
    "@lyness/lyn-compaction-image-offload": "workspace:*",
    "@lyness/lyn-deepseek-llm-api-extensions": "workspace:*",
    "@lyness/lyn-fs-local": "workspace:*",
    "@lyness/lyn-jobs-local": "workspace:*",
    "@lyness/lyn-llm": "workspace:*",
    "@lyness/lyn-llm-deepseek-api-key": "workspace:*",
    "@lyness/lyn-llm-retry": "workspace:*",
    "@lyness/lyn-mcp-resources": "workspace:*",
    "@lyness/lyn-plugin-package-inventory-deepseek": "workspace:*",
    "@lyness/lyn-sandbox-local": "workspace:*",
    "@lyness/lyn-sandbox-policy": "workspace:*",
    "@lyness/lyn-sdk-app": "workspace:*",
    "@lyness/lyn-sdk-jsonrpc-server": "workspace:*",
    "@lyness/lyn-session": "workspace:*",
    "@lyness/lyn-session-checkpoint-policy": "workspace:*",
    "@lyness/lyn-session-log-deepseek": "workspace:*",
    "@lyness/lyn-session-persistence-jsonl": "workspace:*",
    "@lyness/lyn-session-projection": "workspace:*",
    "@lyness/lyn-session-title": "workspace:*",
    "@lyness/lyn-subprocess-local": "workspace:*",
    "@lyness/lyn-system-prompt": "workspace:*",
    "@lyness/lyn-terminal": "workspace:*",
    "@lyness/lyn-terminal-bash": "workspace:*",
    "@lyness/lyn-token-meter": "workspace:*",
    "@lyness/lyn-tool-bash-persistent": "workspace:*",
    "@lyness/lyn-tool-executor-native": "workspace:*",
    "@lyness/lyn-tool-fs": "workspace:*",
    "@lyness/lyn-tool-pwsh-persistent": "workspace:*",
    "@lyness/lyn-tool-working-directory": "workspace:*",
    "@lyness/lyn-tools": "workspace:*",
    "@lyness/lyn-working-directory": "workspace:*"
  },
  "peerDependencies": {
    "@lyness/cordis": "workspace:~"
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:~"
  }
}
