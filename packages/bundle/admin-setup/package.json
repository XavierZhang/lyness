{
  "name": "@lyness/lyn-admin-setup",
  "description": "The lyn admin-setup profile bundle: write a deployment's first platform administrator, their provider and their binding into a profile",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/bundle/admin-setup"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "lyn": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@lyness/lyn-app-boot": "workspace:*",
    "@lyness/lyn-atomic-write": "workspace:*",
    "@lyness/lyn-cmdline": "workspace:*",
    "@lyness/lyn-credentials": "workspace:*",
    "@lyness/lyn-home-paths": "workspace:*",
    "@lyness/lyn-official-bundles": "workspace:*",
    "@lyness/lyn-oidc": "workspace:*",
    "commander": "^15.0.0",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@lyness/cordis": "workspace:~"
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:~"
  }
}
