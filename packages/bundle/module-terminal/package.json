{
  "name": "@lyness/lyn-module-terminal",
  "description": "The persistent terminal default module as its own bundle: the per-agent shell group and its tools",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/bundle/module-terminal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "lyn": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@lyness/cordis": "workspace:~"
  },
  "dependencies": {
    "@lyness/lyn-terminal": "workspace:*",
    "@lyness/lyn-terminal-bash": "workspace:*",
    "@lyness/lyn-tool-terminal": "workspace:*"
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:~"
  }
}
