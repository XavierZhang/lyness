{
  "name": "@deepseek-ai/dsh-module-accounts",
  "description": "The accounts module as its own bundle: who exists, how they sign in, and whose conversation is whose",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/module-accounts"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "dependencies": {
    "@deepseek-ai/dsh-acting-context": "workspace:*",
    "@deepseek-ai/dsh-api-bots-controller": "workspace:*",
    "@deepseek-ai/dsh-bot-ask": "workspace:*",
    "@deepseek-ai/dsh-api-people-controller": "workspace:*",
    "@deepseek-ai/dsh-api-remote-authority": "workspace:*",
    "@deepseek-ai/dsh-api-sign-in-channel-controller": "workspace:*",
    "@deepseek-ai/dsh-auth-session": "workspace:*",
    "@deepseek-ai/dsh-dingtalk": "workspace:*",
    "@deepseek-ai/dsh-feishu": "workspace:*",
    "@deepseek-ai/dsh-managed-bots": "workspace:*",
    "@deepseek-ai/dsh-admin-audit": "workspace:*",
    "@deepseek-ai/dsh-api-admin-audit-controller": "workspace:*",
    "@deepseek-ai/dsh-managed-people": "workspace:*",
    "@deepseek-ai/dsh-people": "workspace:*",
    "@deepseek-ai/dsh-request-principal": "workspace:*",
    "@deepseek-ai/dsh-session-ownership": "workspace:*",
    "@deepseek-ai/dsh-sign-in": "workspace:*",
    "@deepseek-ai/dsh-sign-in-channels": "workspace:*",
    "@deepseek-ai/dsh-sign-in-http": "workspace:*",
    "@deepseek-ai/dsh-wecom": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  }
}
