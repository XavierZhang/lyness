{
  "name": "@lyness/lyn-module-accounts",
  "description": "The accounts module as its own bundle: who exists, how they sign in, and whose conversation is whose",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/bundle/module-accounts"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "lyn": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@lyness/cordis": "workspace:~"
  },
  "dependencies": {
    "@lyness/lyn-acting-context": "workspace:*",
    "@lyness/lyn-api-remote-authority": "workspace:*",
    "@lyness/lyn-api-sign-in-channel-controller": "workspace:*",
    "@lyness/lyn-auth-session": "workspace:*",
    "@lyness/lyn-dingtalk": "workspace:*",
    "@lyness/lyn-feishu": "workspace:*",
    "@lyness/lyn-people": "workspace:*",
    "@lyness/lyn-request-principal": "workspace:*",
    "@lyness/lyn-session-ownership": "workspace:*",
    "@lyness/lyn-sign-in": "workspace:*",
    "@lyness/lyn-sign-in-channels": "workspace:*",
    "@lyness/lyn-sign-in-http": "workspace:*",
    "@lyness/lyn-wecom": "workspace:*"
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:~"
  }
}
