{
  "name": "@lyness/headless",
  "description": "The lyn one-shot bundle: a direct core Agent/Session runner over lyn-base with no Host, HTTP, or browser layer",
  "version": "0.1.5-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/bundle/headless"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/startup.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "lyn": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@lyness/brand": "workspace:^",
    "@lyness/cmdline": "workspace:^",
    "@lyness/code-runtime-worker-thread": "workspace:^",
    "@lyness/util-values": "workspace:^",
    "@lyness/schemastery": "workspace:^",
    "commander": "^15.0.0"
  },
  "peerDependencies": {
    "@lyness/cordis": "workspace:^",
    "@lyness/cordis-plugin-loader": "workspace:^",
    "@lyness/agent": "workspace:^",
    "@lyness/agent-default-model": "workspace:^",
    "@lyness/llm": "workspace:^",
    "@lyness/session": "workspace:^"
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:^",
    "@lyness/cordis-plugin-loader": "workspace:^",
    "@lyness/agent": "workspace:^",
    "@lyness/agent-default-model": "workspace:^",
    "@lyness/agent-loop": "workspace:^",
    "@lyness/agent-loop-testkit": "workspace:^",
    "@lyness/llm": "workspace:^",
    "@lyness/session": "workspace:^"
  }
}
