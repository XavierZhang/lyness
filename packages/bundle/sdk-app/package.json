{
  "name": "@lyness/lyn-sdk-app",
  "description": "The lyn SDK profile bundle: stdio JSON-RPC serving and process lifecycle over lyn-base",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/bundle/sdk-app"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "lyn": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@lyness/lyn-client-connection": "workspace:*",
    "@lyness/lyn-client-file-upload": "workspace:*",
    "@lyness/lyn-cmdline": "workspace:*",
    "@lyness/lyn-deliverable-file-references": "workspace:*",
    "@lyness/lyn-file-reference-local": "workspace:*",
    "@lyness/lyn-schedule": "workspace:*",
    "@lyness/lyn-sdk-jsonrpc-server": "workspace:*",
    "@lyness/lyn-skill-office": "workspace:*",
    "@lyness/lyn-time-context": "workspace:*",
    "@lyness/lyn-tool-ask-user": "workspace:*",
    "@lyness/lyn-tool-present": "workspace:*",
    "@lyness/lyn-tool-schedule": "workspace:*",
    "@lyness/lyn-tool-workspace-dependencies": "workspace:*",
    "@lyness/lyn-workspace": "workspace:*",
    "@lyness/schemastery": "workspace:~",
    "commander": "^15.0.0"
  },
  "peerDependencies": {
    "@lyness/cordis": "workspace:~"
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/cordis-plugin-include": "workspace:~"
  }
}
