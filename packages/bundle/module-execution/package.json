{
  "name": "@lyness/lyn-module-execution",
  "description": "The execution default module as its own bundle: the filesystem, subprocess and sandbox providers, the shell and file tools, and the code and workflow runtimes",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/bundle/module-execution"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "lyn": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@lyness/cordis": "workspace:~"
  },
  "dependencies": {
    "@lyness/lyn-bash-sandbox": "workspace:*",
    "@lyness/lyn-fs-observation-policy": "workspace:*",
    "@lyness/lyn-fs-sandbox": "workspace:*",
    "@lyness/lyn-ptc-runtime-node": "workspace:*",
    "@lyness/lyn-pwsh-sandbox": "workspace:*",
    "@lyness/lyn-sandbox-local": "workspace:*",
    "@lyness/lyn-sandbox-policy": "workspace:*",
    "@lyness/lyn-shell-env": "workspace:*",
    "@lyness/lyn-subprocess-local": "workspace:*",
    "@lyness/lyn-tool-bash": "workspace:*",
    "@lyness/lyn-tool-fs": "workspace:*",
    "@lyness/lyn-tool-fs-search": "workspace:*",
    "@lyness/lyn-tool-pwsh": "workspace:*",
    "@lyness/lyn-tool-ralph": "workspace:*",
    "@lyness/lyn-tool-workflow": "workspace:*",
    "@lyness/lyn-workflow-ptc": "workspace:*"
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:~"
  }
}
