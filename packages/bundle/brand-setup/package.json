{
  "name": "@lyness/lyn-brand-setup",
  "description": "The lyn brand-setup profile bundle: a loopback page an operator brands a deployment from, reached through a one-time token the command prints",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/bundle/brand-setup"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/startup.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "lyn": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@lyness/lyn-brand-studio": "workspace:*",
    "@lyness/lyn-cmdline": "workspace:*",
    "@lyness/lyn-home-paths": "workspace:*",
    "@lyness/lyn-host-brand-deployment": "workspace:*",
    "@lyness/lyn-host-webserver": "workspace:*",
    "@lyness/schemastery": "workspace:~",
    "commander": "^15.0.0",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@lyness/cordis": "workspace:~"
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:~"
  }
}
