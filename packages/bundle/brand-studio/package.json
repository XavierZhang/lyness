{
  "name": "@deepseek-ai/dsh-brand-studio",
  "description": "The dsh brand-studio profile bundle: generate a deployment brand from an icon PNG and a font, and apply it to a profile",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/brand-studio"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-app-boot": "workspace:*",
    "@deepseek-ai/dsh-atomic-write": "workspace:*",
    "@deepseek-ai/dsh-cmdline": "workspace:*",
    "@deepseek-ai/dsh-home-paths": "workspace:*",
    "@deepseek-ai/dsh-host-brand-deployment": "workspace:*",
    "@deepseek-ai/dsh-host-brand-fonts": "workspace:*",
    "@deepseek-ai/dsh-host-brand-icon": "workspace:*",
    "@deepseek-ai/dsh-host-brand-wordmark": "workspace:*",
    "commander": "^15.0.0",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@deepseek-ai/cordis": "workspace:~"
  }
}
