{
  "name": "@lyness/lyn-tenant-session",
  "description": "Records the tenant a session belongs to, and the identity text that tenant contributed, as one durable session event",
  "version": "0.1.5-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/tenant/tenant-session"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@lyness/lyn-session": "workspace:^",
    "@lyness/lyn-session-projection": "workspace:^",
    "@lyness/lyn-tenant": "workspace:^",
    "@lyness/lyn-tenant-config": "workspace:^",
    "@lyness/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@lyness/cordis": "workspace:^"
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:^",
    "@lyness/cordis-plugin-include": "workspace:^",
    "@lyness/cordis-plugin-loader": "workspace:^",
    "@lyness/lyn-tenant-config-static": "workspace:^",
    "@lyness/lyn-tenant-static": "workspace:^"
  }
}
