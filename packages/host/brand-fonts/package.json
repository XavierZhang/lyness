{
  "name": "@lyness/lyn-host-brand-fonts",
  "description": "The platform's built-in wordmark fonts: Inter SemiBold and Noto Sans CJK SC Medium, in fallback order, under the SIL Open Font License",
  "version": "0.1.5-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/host/brand-fonts"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "fonts",
    "third-party-assets.json",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@lyness/cordis": "workspace:^"
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:^",
    "@lyness/lyn-host-brand-icon": "workspace:^",
    "@lyness/lyn-host-brand-wordmark": "workspace:^"
  }
}
