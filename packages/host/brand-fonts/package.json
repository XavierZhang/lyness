{
  "name": "@deepseek-ai/dsh-host-brand-fonts",
  "description": "The platform's built-in wordmark fonts: Inter SemiBold and Noto Sans CJK SC Medium, in fallback order, under the SIL Open Font License",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/host/brand-fonts"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "fonts",
    "third-party-assets.json",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-host-brand-icon": "workspace:*",
    "@deepseek-ai/dsh-host-brand-wordmark": "workspace:*"
  }
}
