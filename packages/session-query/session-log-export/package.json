{
  "name": "@lyness/lyn-session-log-export",
  "description": "Web Session-log ZIP export and Session Markdown copy",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/session-query/session-log-export"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "@lyness/lyn-brand": "workspace:*",
    "@lyness/lyn-session-format": "workspace:*",
    "@lyness/schemastery": "workspace:~",
    "fflate": "^0.8.2"
  },
  "peerDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-session": "workspace:*",
    "@lyness/lyn-session-persistence": "workspace:*"
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/cordis-plugin-loader": "workspace:~",
    "@lyness/lyn-agent": "workspace:*",
    "@lyness/lyn-attachment": "workspace:*",
    "@lyness/lyn-client-connection": "workspace:*",
    "@lyness/lyn-client-locale": "workspace:*",
    "@lyness/lyn-client-store": "workspace:*",
    "@lyness/lyn-client-ui-commands": "workspace:*",
    "@lyness/lyn-client-ui-conversation": "workspace:*",
    "@lyness/lyn-client-ui-layout": "workspace:*",
    "@lyness/lyn-client-ui-message-feedback": "workspace:*",
    "@lyness/lyn-client-ui-primitives": "workspace:*",
    "@lyness/lyn-client-ui-renderer": "workspace:*",
    "@lyness/lyn-client-ui-session": "workspace:*",
    "@lyness/lyn-client-ui-slots": "workspace:*",
    "@lyness/lyn-commands": "workspace:*",
    "@lyness/lyn-session": "workspace:*",
    "@lyness/lyn-session-ownership": "workspace:*",
    "@lyness/lyn-session-persistence": "workspace:*",
    "@lyness/lyn-session-query": "workspace:*",
    "@lyness/lyn-session-title": "workspace:*",
    "react": "^18.2.0"
  },
  "lyn": {
    "client": {
      "inject": [
        "@lyness/lyn-client-locale",
        "@lyness/lyn-client-ui-commands",
        "@lyness/lyn-client-ui-conversation",
        "@lyness/lyn-client-ui-layout",
        "@lyness/lyn-client-ui-renderer",
        "@lyness/lyn-client-ui-session"
      ],
      "platform": "web"
    }
  }
}
