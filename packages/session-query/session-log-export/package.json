{
  "name": "@lyness/session-log-export",
  "description": "Web Session-log export command and shared download dialog",
  "version": "0.1.2-alpha.1",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/session-query/session-log-export"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./invariant": { "types": "./lib/types/invariant.d.ts", "default": "./lib/invariant.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/invariant.js", "lib/client.js", "lib/types/**/*.d.ts"],
  "scripts": { "bundle": "tsdown", "watch": "tsdown --watch" },
  "license": "MIT",
  "dependencies": {
    "@lyness/schemastery": "workspace:^",
    "fflate": "^0.8.2"
  },
  "peerDependencies": {
    "@lyness/cordis": "workspace:^",
    "@lyness/attachment": "workspace:^",
    "@lyness/client-connection": "workspace:^",
    "@lyness/client-locale": "workspace:^",
    "@lyness/client-ui-commands": "workspace:^",
    "@lyness/client-ui-conversation": "workspace:^",
    "@lyness/client-ui-renderer": "workspace:^",
    "@lyness/client-ui-session": "workspace:^",
    "@lyness/commands": "workspace:^",
    "@lyness/invariants": "workspace:^",
    "@lyness/session": "workspace:^",
    "@lyness/session-persistence": "workspace:^",
    "@lyness/session-query": "workspace:^"
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:^",
    "@lyness/cordis-plugin-loader": "workspace:^",
    "@lyness/agent": "workspace:^",
    "@lyness/attachment": "workspace:^",
    "@lyness/client-connection": "workspace:^",
    "@lyness/client-locale": "workspace:^",
    "@lyness/client-store": "workspace:^",
    "@lyness/client-ui-commands": "workspace:^",
    "@lyness/client-ui-conversation": "workspace:^",
    "@lyness/client-ui-renderer": "workspace:^",
    "@lyness/client-ui-session": "workspace:^",
    "@lyness/client-ui-primitives": "workspace:^",
    "@lyness/client-ui-slots": "workspace:^",
    "@lyness/commands": "workspace:^",
    "@lyness/invariants": "workspace:^",
    "@lyness/session": "workspace:^",
    "@lyness/session-persistence": "workspace:^",
    "@lyness/session-query": "workspace:^",
    "@types/react": "~18.3.1",
    "react": "^18.2.0"
  },
  "lyn": {
    "client": {
      "inject": [
        "@lyness/client-locale",
        "@lyness/client-ui-commands",
        "@lyness/client-ui-conversation",
        "@lyness/client-ui-renderer",
        "@lyness/client-ui-session"
      ],
      "platform": "web"
    }
  }
}
