{
  "name": "@lyness/lyn-workflow-worker-thread",
  "description": "worker-thread workflow engine: executes model-written orchestration scripts off the host event loop, bridging agent() calls back to ctx.subagents",
  "version": "0.1.5-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/workflow/workflow-worker-thread"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./worker": {
      "types": "./lib/types/worker.d.ts",
      "default": "./lib/worker.cjs"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/worker.cjs",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@lyness/cordis": "workspace:^",
    "@lyness/lyn-agent": "workspace:^",
    "@lyness/lyn-llm": "workspace:^",
    "@lyness/lyn-session": "workspace:^",
    "@lyness/lyn-subagent": "workspace:^",
    "@lyness/lyn-tools": "workspace:^",
    "@lyness/lyn-workflow": "workspace:^"
  },
  "dependencies": {
    "@lyness/lyn-brand": "workspace:^",
    "@lyness/lyn-util-values": "workspace:^",
    "@lyness/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:^",
    "@lyness/lyn-agent": "workspace:^",
    "@lyness/lyn-agent-loop": "workspace:^",
    "@lyness/lyn-agent-loop-testkit": "workspace:^",
    "@lyness/lyn-e2e-target": "workspace:^",
    "@lyness/lyn-http-proxy": "workspace:^",
    "@lyness/lyn-invariants": "workspace:^",
    "@lyness/lyn-llm": "workspace:^",
    "@lyness/lyn-session": "workspace:^",
    "@lyness/lyn-session-projection": "workspace:^",
    "@lyness/lyn-subagent": "workspace:^",
    "@lyness/lyn-subagent-spawn-in-process": "workspace:^",
    "@lyness/lyn-system-prompt": "workspace:^",
    "@lyness/lyn-tools": "workspace:^",
    "@lyness/lyn-workflow": "workspace:^",
    "tsx": "^4.19.2"
  }
}
