{
  "name": "@lyness/lyn-tool-workflow",
  "description": "Model-facing workflow tool: run a JavaScript orchestration script over ctx.workflowEngine",
  "version": "0.1.5-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/workflow/tool-workflow"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@lyness/lyn-agent": "workspace:^",
    "@lyness/lyn-invariants": "workspace:^",
    "@lyness/lyn-llm": "workspace:^",
    "@lyness/lyn-session": "workspace:^",
    "@lyness/lyn-system-prompt": "workspace:^",
    "@lyness/lyn-tools": "workspace:^",
    "@lyness/lyn-workflow": "workspace:^",
    "@lyness/cordis": "workspace:^"
  },
  "dependencies": {
    "@lyness/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@lyness/lyn-agent": "workspace:^",
    "@lyness/lyn-invariants": "workspace:^",
    "@lyness/lyn-llm": "workspace:^",
    "@lyness/lyn-session": "workspace:^",
    "@lyness/lyn-subagent": "workspace:^",
    "@lyness/lyn-system-prompt": "workspace:^",
    "@lyness/lyn-tools": "workspace:^",
    "@lyness/lyn-workflow": "workspace:^",
    "@lyness/lyn-workflow-worker-thread": "workspace:^",
    "@lyness/cordis": "workspace:^",
    "@lyness/lyn-session-projection": "workspace:^"
  }
}
