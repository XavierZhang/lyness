{
  "name": "@lyness/lyn-sandbox-policy",
  "description": "Per-call sandbox policy resolver and current model context: deployment fallbacks plus each session's mode and workspace root, shared by every enforcing capability family",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/sandbox/sandbox-policy"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@lyness/lyn-agent": "workspace:*",
    "@lyness/lyn-sandbox": "workspace:*",
    "@lyness/lyn-session": "workspace:*",
    "@lyness/lyn-system-prompt": "workspace:*",
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-session-projection": "workspace:*"
  },
  "dependencies": {
    "@lyness/schemastery": "workspace:~",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@lyness/lyn-brand": "workspace:*",
    "@lyness/lyn-agent": "workspace:*",
    "@lyness/lyn-sandbox": "workspace:*",
    "@lyness/lyn-session": "workspace:*",
    "@lyness/lyn-system-prompt": "workspace:*",
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-session-projection": "workspace:*"
  }
}
