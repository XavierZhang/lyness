{
  "name": "@lyness/lyn-sdk-jsonrpc-server",
  "description": "Stdio JSON-RPC server plugin for out-of-process lyness SDK clients",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/sdk/server"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@lyness/lyn-brand": "workspace:*",
    "@lyness/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-agent": "workspace:*",
    "@lyness/lyn-attachment": "workspace:*",
    "@lyness/lyn-llm": "workspace:*",
    "@lyness/lyn-llm-deepseek-api-key": "workspace:*",
    "@lyness/lyn-schedule": "workspace:*",
    "@lyness/lyn-scope": "workspace:*",
    "@lyness/lyn-sdk-protocol": "workspace:*",
    "@lyness/lyn-session": "workspace:*",
    "@lyness/lyn-subagent": "workspace:*",
    "@lyness/lyn-user-approval": "workspace:*",
    "@lyness/lyn-user-questions": "workspace:*",
    "@lyness/lyn-working-directory": "workspace:*"
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/cordis-plugin-loader": "workspace:~",
    "@lyness/lyn-agent": "workspace:*",
    "@lyness/lyn-agent-loop": "workspace:*",
    "@lyness/lyn-agent-loop-testkit": "workspace:*",
    "@lyness/lyn-attachment": "workspace:*",
    "@lyness/lyn-llm": "workspace:*",
    "@lyness/lyn-llm-deepseek-api-key": "workspace:*",
    "@lyness/lyn-schedule": "workspace:*",
    "@lyness/lyn-scope": "workspace:*",
    "@lyness/lyn-sdk-protocol": "workspace:*",
    "@lyness/lyn-session": "workspace:*",
    "@lyness/lyn-session-persistence-jsonl": "workspace:*",
    "@lyness/lyn-session-projection": "workspace:*",
    "@lyness/lyn-subagent": "workspace:*",
    "@lyness/lyn-user-approval": "workspace:*",
    "@lyness/lyn-user-questions": "workspace:*",
    "@lyness/lyn-working-directory": "workspace:*"
  }
}
