{
  "name": "@lyness/lyn-sdk-client",
  "description": "TypeScript client SDK for driving a lyness runtime subprocess over stdio JSON-RPC: the Lyness high-level turns API and the lower-level HarnessClient",
  "version": "0.1.5-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/sdk/client"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@lyness/lyn": "workspace:*"
  },
  "peerDependencies": {
    "@lyness/lyn-llm": "workspace:^",
    "@lyness/lyn-sdk-protocol": "workspace:^",
    "@lyness/lyn-session": "workspace:^",
    "@lyness/cordis": "workspace:^"
  },
  "devDependencies": {
    "@lyness/lyn-llm": "workspace:^",
    "@lyness/lyn-sdk-protocol": "workspace:^",
    "@lyness/lyn-session": "workspace:^",
    "@lyness/cordis": "workspace:^"
  }
}
