    "lib/worker.cjs",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@lyness/lyn-session": "workspace:*",
    "@lyness/lyn-session-persistence": "workspace:*",
    "@lyness/cordis": "workspace:~"
  },
  "dependencies": {
    "@lyness/lyn-llm": "workspace:*",
    "@lyness/lyn-session-format": "workspace:*",
    "@lyness/lyn-session-format-catalog": "workspace:*",
    "@lyness/lyn-session-format-v3-to-v4": "workspace:*",
    "@lyness/node-addon-system": "workspace:~",
    "@lyness/schemastery": "workspace:~",
    "koffi": "^3.1.0"
  },
  "devDependencies": {
    "@lyness/lyn-session": "workspace:*",
    "@lyness/lyn-session-format-v0-to-v1": "workspace:*",
    "@lyness/lyn-session-persistence": "workspace:*",
    "@lyness/cordis": "workspace:~"
  }
}
