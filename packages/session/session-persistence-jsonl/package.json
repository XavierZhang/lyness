{
  "name": "@lyness/lyn-session-persistence-jsonl",
  "description": "JSONL durable session persistence backend for the lyness",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/session/session-persistence-jsonl"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/worker.cjs",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-session": "workspace:*",
    "@lyness/lyn-session-persistence": "workspace:*"
  },
  "dependencies": {
    "@lyness/lyn-llm": "workspace:*",
    "@lyness/lyn-session-format": "workspace:*",
    "@lyness/lyn-session-format-catalog": "workspace:*",
    "@lyness/lyn-session-format-v3-to-v4": "workspace:*",
    "@lyness/node-addon-system": "workspace:~",
    "@lyness/schemastery": "workspace:~",
    "koffi": "3.1.1",
    "p-limit": "7.3.3"
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-session": "workspace:*",
    "@lyness/lyn-session-format-v0-to-v1": "workspace:*",
    "@lyness/lyn-session-persistence": "workspace:*"
  }
}
