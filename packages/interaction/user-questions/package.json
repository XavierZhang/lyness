{
  "name": "@lyness/lyn-user-questions",
  "description": "Abstract user-questions seam (ctx.userQuestions) for asking the human during agent runs",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/interaction/user-questions"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/typert.remote-client.d.ts.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@lyness/lyn-agent": "workspace:*",
    "@lyness/lyn-llm": "workspace:*",
    "@lyness/lyn-scope": "workspace:*",
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-typert-protocol": "workspace:*",
    "@lyness/lyn-session": "workspace:*",
    "@lyness/lyn-session-projection": "workspace:*"
  },
  "devDependencies": {
    "@lyness/lyn-agent": "workspace:*",
    "@lyness/lyn-error": "workspace:*",
    "@lyness/lyn-llm": "workspace:*",
    "@lyness/lyn-scope": "workspace:*",
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-tool-executor-ptc": "workspace:*",
    "@lyness/lyn-typert-protocol": "workspace:*",
    "@lyness/lyn-session": "workspace:*",
    "@lyness/lyn-session-projection": "workspace:*",
    "@lyness/lyn-session-persistence-jsonl": "workspace:*"
  },
  "dependencies": {
    "@lyness/lyn-brand": "workspace:*",
    "zod": "4.6.6",
    "@lyness/schemastery": "workspace:~"
  }
}
