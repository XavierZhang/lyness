{
  "name": "@lyness/user-approval",
  "description": "User-approval seam (ctx.approval) for the lyness: one-shot permission decisions dispatched to composed answerers over the approval/request waterfall, fail-closed by default",
  "version": "0.1.5-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/interaction/user-approval"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@lyness/agent": "workspace:^",
    "@lyness/brand": "workspace:^",
    "@lyness/invariants": "workspace:^",
    "@lyness/llm": "workspace:^",
    "@lyness/scope": "workspace:^",
    "@lyness/session": "workspace:^",
    "@lyness/system-prompt": "workspace:^",
    "@lyness/cordis": "workspace:^"
  },
  "dependencies": {
    "@lyness/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@lyness/agent": "workspace:^",
    "@lyness/brand": "workspace:^",
    "@lyness/invariants": "workspace:^",
    "@lyness/llm": "workspace:^",
    "@lyness/scope": "workspace:^",
    "@lyness/session": "workspace:^",
    "@lyness/system-prompt": "workspace:^",
    "@lyness/cordis": "workspace:^"
  }
}
