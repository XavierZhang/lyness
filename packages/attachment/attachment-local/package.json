{
  "name": "@lyness/lyn-attachment-local",
  "description": "Private content-addressed LYNESS_HOME attachment storage",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/attachment/attachment-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-attachment": "workspace:*",
    "@lyness/lyn-home-paths": "workspace:*"
  },
  "dependencies": {
    "@lyness/lyn-lazy-require": "workspace:*",
    "@lyness/schemastery": "workspace:~",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-attachment": "workspace:*",
    "@lyness/lyn-home-paths": "workspace:*"
  }
}
