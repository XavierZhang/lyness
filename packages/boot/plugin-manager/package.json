{
  "name": "@lyness/lyn-plugin-manager",
  "description": "Current-profile plugin and bundle management shared by lyn CLI, Web and agent tools",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/boot/plugin-manager"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./registry": {
      "types": "./lib/types/registry.d.ts",
      "default": "./lib/types/registry.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./operations": {
      "types": "./lib/types/operations.d.ts",
      "default": "./lib/types/operations.js"
    },
    "./tools": {
      "types": "./lib/types/tools.d.ts",
      "default": "./lib/types/tools.js"
    },
    "./tools/locale/*.json": "./locale/tools/*.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "locale/tools/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@lyness/lyn-app-boot": "workspace:*",
    "@lyness/lyn-atomic-write": "workspace:*",
    "@lyness/lyn-official-bundles": "workspace:*",
    "@lyness/lyn-plugin-detail": "workspace:*",
    "@lyness/lyn-timeout": "workspace:*",
    "@lyness/lyn-util-values": "workspace:*",
    "@lyness/schemastery": "workspace:~",
    "execa": "^10.0.1",
    "hosted-git-info": "^9.0.3",
    "semver": "^7.8.5",
    "yaml": "^2.9.0",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/cordis-plugin-loader": "workspace:~",
    "@lyness/lyn-brand": "workspace:*",
    "@lyness/lyn-hmr": "workspace:*",
    "@lyness/lyn-host-plugin-inventory": "workspace:*",
    "@lyness/lyn-sandbox": "workspace:*",
    "@lyness/lyn-sandbox-policy": "workspace:*",
    "@lyness/lyn-subprocess": "workspace:*",
    "@lyness/lyn-tools": "workspace:*",
    "@lyness/lyn-typert-protocol": "workspace:*",
    "@lyness/lyn-user-approval": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@lyness/lyn-hmr": {
      "optional": true
    },
    "@lyness/lyn-user-approval": {
      "optional": true
    }
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/cordis-plugin-loader": "workspace:~",
    "@lyness/cordis-plugin-timer": "workspace:~",
    "@lyness/lyn-agent": "workspace:*",
    "@lyness/lyn-brand": "workspace:*",
    "@lyness/lyn-client-connection": "workspace:*",
    "@lyness/lyn-hmr": "workspace:*",
    "@lyness/lyn-host-plugin-inventory": "workspace:*",
    "@lyness/lyn-package-manifest": "workspace:*",
    "@lyness/lyn-sandbox": "workspace:*",
    "@lyness/lyn-sandbox-policy": "workspace:*",
    "@lyness/lyn-session": "workspace:*",
    "@lyness/lyn-session-projection": "workspace:*",
    "@lyness/lyn-subprocess": "workspace:*",
    "@lyness/lyn-system-prompt": "workspace:*",
    "@lyness/lyn-tool-executor-native": "workspace:*",
    "@lyness/lyn-tool-testkit": "workspace:*",
    "@lyness/lyn-tools": "workspace:*",
    "@lyness/lyn-typert-protocol": "workspace:*",
    "@lyness/lyn-user-approval": "workspace:*",
    "@types/hosted-git-info": "^3.0.5",
    "@types/semver": "^7.8.0",
    "chokidar": "^4.0.3"
  }
}
