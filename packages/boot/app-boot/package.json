{
  "name": "@lyness/lyn-app-boot",
  "description": "Shared boot glue for the app bins: .env loading, fail-loud Loader guards, snapshot-aware config resolution, and the Loader boot sequence",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/boot/app-boot"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./worker/profile-resolution-bootstrap": {
      "types": "./lib/types/profile-resolution/worker-bootstrap.d.ts",
      "default": "./lib/worker/profile-resolution-bootstrap.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/worker/profile-resolution-bootstrap.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@lyness/lyn-atomic-write": "workspace:*",
    "@lyness/lyn-official-bundles": "workspace:*",
    "@lyness/lyn-package-manifest": "workspace:*",
    "@eslint-community/regexpp": "^4.12.2",
    "ajv": "^8.20.0",
    "node-addon-require-builtin": "^0.1.9",
    "resolve.exports": "^2.0.3",
    "semver": "^7.8.5",
    "@lyness/lyn-native-command": "workspace:*"
  },
  "peerDependencies": {
    "@lyness/cordis-plugin-group": "workspace:~",
    "@lyness/cordis-plugin-include": "workspace:~",
    "@lyness/cordis-plugin-loader": "workspace:~",
    "@lyness/lyn-launch-environment": "workspace:*",
    "@lyness/lyn-home-paths": "workspace:*",
    "@lyness/cordis": "workspace:~"
  },
  "devDependencies": {
    "@lyness/schemastery": "workspace:~",
    "@lyness/cordis-plugin-group": "workspace:~",
    "@lyness/cordis-plugin-include": "workspace:~",
    "@lyness/cordis-plugin-loader": "workspace:~",
    "@lyness/cordis-plugin-timer": "workspace:~",
    "@lyness/lyn-launch-environment": "workspace:*",
    "@lyness/lyn-home-paths": "workspace:*",
    "@lyness/lyn-system-prompt": "workspace:*",
    "@types/semver": "^7.8.0",
    "@lyness/cordis": "workspace:~"
  }
}
