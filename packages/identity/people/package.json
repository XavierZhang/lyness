{
  "name": "@lyness/lyn-people",
  "description": "People and their standing in an organization: the directory seam, the roles, and the operator-written provider",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/identity/people"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./static": {
      "types": "./lib/types/static.d.ts",
      "default": "./lib/types/static.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@lyness/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-brand": "workspace:*"
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-brand": "workspace:*"
  }
}
