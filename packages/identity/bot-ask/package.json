    },
    "./room": {
      "types": "./lib/types/room.d.ts",
      "default": "./lib/types/room.js"
    },
    "./room-session": {
      "types": "./lib/types/room-session.d.ts",
      "default": "./lib/types/room-session.js"
    },
    "./turn": {
      "types": "./lib/types/turn.d.ts",
      "default": "./lib/types/turn.js"
    },
    "./tool": {
      "types": "./lib/types/tool.d.ts",
      "default": "./lib/types/tool.js"
    },
    "./preset-contribution": {
      "types": "./lib/types/preset-contribution.d.ts",
      "default": "./lib/types/preset-contribution.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
