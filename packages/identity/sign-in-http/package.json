{
  "name": "@lyness/lyn-sign-in-http",
  "description": "The browser-facing half of signing in: the sign-in, callback, channel-list and sign-out routes, and the session cookie",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/identity/sign-in-http"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cookie": {
      "types": "./lib/types/cookie.d.ts",
      "default": "./lib/types/cookie.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-auth-session": "workspace:*",
    "@lyness/lyn-brand": "workspace:*",
    "@lyness/lyn-host-webserver": "workspace:*",
    "@lyness/lyn-sign-in": "workspace:*",
    "@lyness/lyn-util-values": "workspace:*"
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-auth-session": "workspace:*",
    "@lyness/lyn-brand": "workspace:*",
    "@lyness/lyn-host-webserver": "workspace:*",
    "@lyness/lyn-people": "workspace:*",
    "@lyness/lyn-sign-in": "workspace:*",
    "@lyness/lyn-storage": "workspace:*",
    "@lyness/lyn-storage-domain": "workspace:*",
    "@lyness/lyn-storage-json": "workspace:*",
    "@lyness/lyn-util-values": "workspace:*"
  },
  "dependencies": {
    "@lyness/schemastery": "workspace:~"
  }
}
