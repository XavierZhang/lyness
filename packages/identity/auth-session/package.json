{
  "name": "@lyness/lyn-auth-session",
  "description": "Signed-in sessions: established on sign-in, holding the context in force, expired on read",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/identity/auth-session"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./store": {
      "types": "./lib/types/store.d.ts",
      "default": "./lib/types/store.js"
    },
    "./storage": {
      "types": "./lib/types/storage.d.ts",
      "default": "./lib/types/storage.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@lyness/schemastery": "workspace:~",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-brand": "workspace:*",
    "@lyness/lyn-people": "workspace:*",
    "@lyness/lyn-storage-domain": "workspace:*",
    "@lyness/lyn-util-crypto": "workspace:*"
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-brand": "workspace:*",
    "@lyness/lyn-people": "workspace:*",
    "@lyness/lyn-storage-domain": "workspace:*",
    "@lyness/lyn-util-crypto": "workspace:*",
    "@lyness/lyn-storage": "workspace:*",
    "@lyness/lyn-storage-json": "workspace:*"
  }
}
