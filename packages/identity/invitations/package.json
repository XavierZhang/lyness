{
  "name": "@lyness/lyn-invitations",
  "description": "Invitations: the bounded code an administrator sends so somebody nobody has heard of can join",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/identity/invitations"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./storage": {
      "types": "./lib/types/storage.d.ts",
      "default": "./lib/types/storage.js"
    },
    "./admission": {
      "types": "./lib/types/admission.d.ts",
      "default": "./lib/types/admission.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@lyness/schemastery": "workspace:~",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-admin-audit": "workspace:*",
    "@lyness/lyn-brand": "workspace:*",
    "@lyness/lyn-managed-people": "workspace:*",
    "@lyness/lyn-people": "workspace:*",
    "@lyness/lyn-sign-in": "workspace:*",
    "@lyness/lyn-storage-domain": "workspace:*",
    "@lyness/lyn-util-crypto": "workspace:*"
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-admin-audit": "workspace:*",
    "@lyness/lyn-brand": "workspace:*",
    "@lyness/lyn-managed-people": "workspace:*",
    "@lyness/lyn-people": "workspace:*",
    "@lyness/lyn-sign-in": "workspace:*",
    "@lyness/lyn-storage": "workspace:*",
    "@lyness/lyn-storage-domain": "workspace:*",
    "@lyness/lyn-storage-json": "workspace:*",
    "@lyness/lyn-util-crypto": "workspace:*"
  }
}
