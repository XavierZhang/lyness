{
  "name": "@lyness/terminal-bash",
  "description": "Persistent shell PTY backend over the lyness subprocess terminal primitive",
  "version": "0.1.5-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/terminal/terminal-bash"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@lyness/agent": "workspace:^",
    "@lyness/terminal": "workspace:^",
    "@lyness/sandbox": "workspace:^",
    "@lyness/sandbox-policy": "workspace:^",
    "@lyness/session": "workspace:^",
    "@lyness/subprocess": "workspace:^",
    "@lyness/cordis": "workspace:^",
    "@lyness/session-projection": "workspace:^"
  },
  "dependencies": {
    "@lyness/pwsh-local": "workspace:^",
    "@lyness/schemastery": "workspace:^",
    "@xterm/headless": "^6.0.0"
  },
  "devDependencies": {
    "@lyness/agent": "workspace:^",
    "@lyness/agent-loop-testkit": "workspace:^",
    "@lyness/terminal": "workspace:^",
    "@lyness/sandbox": "workspace:^",
    "@lyness/sandbox-policy": "workspace:^",
    "@lyness/session": "workspace:^",
    "@lyness/subprocess": "workspace:^",
    "@lyness/subprocess-local": "workspace:^",
    "@lyness/cordis": "workspace:^"
  }
}
