{
  "name": "@lyness/lyn-terminal",
  "description": "Persistent PTY session seam for the lyness — owner-scoped ids, backend registry, interactive sends, reads, signals, and awaited cleanup",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/terminal/terminal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./preset-contribution": {
      "types": "./lib/types/preset-contribution.d.ts",
      "default": "./lib/types/preset-contribution.js"
    },
    "./preset-contribution/locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src",
    "lib/types/**/*.js"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@lyness/lyn-agent": "workspace:*",
    "@lyness/lyn-error": "workspace:*",
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-agent-preset-registry": "workspace:*"
  },
  "dependencies": {
    "@lyness/lyn-brand": "workspace:*",
    "@lyness/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@lyness/lyn-agent": "workspace:*",
    "@lyness/lyn-agent-loop-testkit": "workspace:*",
    "@lyness/lyn-error": "workspace:*",
    "@lyness/lyn-session": "workspace:*",
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-agent-preset-registry": "workspace:*"
  }
}
