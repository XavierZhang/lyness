{
  "name": "@lyness/lyn-client-ui-settings-data",
  "description": "The data section in Settings: a person's own conversations, with the export and the deletion they own",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/client/ui-settings-data"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "lyn": {
    "client": {
      "inject": [
        "@lyness/lyn-client-locale",
        "@lyness/lyn-client-ui-renderer",
        "@lyness/lyn-client-ui-settings",
        "@lyness/lyn-api-remotes"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@lyness/cordis": "workspace:~"
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-api-remotes": "workspace:*",
    "@lyness/lyn-api-session-controller": "workspace:*",
    "@lyness/lyn-api-session-data-controller": "workspace:*",
    "@lyness/lyn-client-locale": "workspace:*",
    "@lyness/lyn-client-store": "workspace:*",
    "@lyness/lyn-client-test-runtime": "workspace:*",
    "@lyness/lyn-client-ui-primitives": "workspace:*",
    "@lyness/lyn-client-ui-renderer": "workspace:*",
    "@lyness/lyn-client-ui-settings": "workspace:*",
    "@lyness/lyn-client-ui-slots": "workspace:*",
    "@lyness/lyn-session": "workspace:*",
    "@lyness/lyn-session-log-export": "workspace:*",
    "@lyness/lyn-typert-protocol": "workspace:*",
    "react": "^18.2.0"
  }
}
