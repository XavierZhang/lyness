{
  "name": "@lyness/client-ui-deliverables",
  "description": "Produced-files turn tail and clickable final-response file references for Web",
  "version": "0.1.5-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/client/ui-deliverables"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "lyn": {
    "client": {
      "inject": [
        "@lyness/api-remotes",
        "@lyness/client-connection",
        "@lyness/client-locale",
        "@lyness/client-ui-chat",
        "@lyness/client-ui-conversation",
        "@lyness/client-ui-renderer",
        "@lyness/client-ui-tool"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@lyness/cordis": "workspace:^"
  },
  "devDependencies": {
    "@lyness/api-remotes": "workspace:^",
    "@lyness/client-connection": "workspace:^",
    "@lyness/client-locale": "workspace:^",
    "@lyness/client-store": "workspace:^",
    "@lyness/client-test-runtime": "workspace:^",
    "@lyness/client-ui-chat": "workspace:^",
    "@lyness/client-ui-conversation": "workspace:^",
    "@lyness/client-ui-renderer": "workspace:^",
    "@lyness/client-ui-slots": "workspace:^",
    "@types/react": "~18.3.1",
    "@lyness/cordis": "workspace:^",
    "react": "^18.2.0",
    "@lyness/client-ui-primitives": "workspace:^",
    "@lyness/session": "workspace:^",
    "@lyness/system-prompt": "workspace:^",
    "@lyness/session-query": "workspace:^",
    "@lyness/llm": "workspace:^",
    "@lyness/client-ui-tool": "workspace:^",
    "@lyness/tool-present": "workspace:^",
    "@lyness/api-session-controller": "workspace:^",
    "@lyness/util-workspace-path": "workspace:^",
    "@lyness/api-workspace-files": "workspace:^",
    "@lyness/fs": "workspace:^",
    "@lyness/fs-local": "workspace:^",
    "@lyness/agent": "workspace:^",
    "@lyness/sandbox-policy": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@lyness/typert-protocol": "workspace:^"
  }
}
