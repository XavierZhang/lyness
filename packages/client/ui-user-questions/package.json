{
  "name": "@lyness/client-ui-user-questions",
  "description": "Web ask_user_question composer takeover and plan-review presentation UI",
  "version": "0.1.5-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/client/ui-user-questions"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "lyn": {
    "client": {
      "inject": [
        "@lyness/api-remotes",
        "@lyness/api-session-controller",
        "@lyness/client-locale",
        "@lyness/client-ui-conversation",
        "@lyness/client-ui-renderer",
        "@lyness/client-ui-session"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@lyness/cordis": "workspace:^"
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:^",
    "@lyness/agent": "workspace:^",
    "@lyness/api-remotes": "workspace:^",
    "@lyness/api-session-controller": "workspace:^",
    "@lyness/client-locale": "workspace:^",
    "@lyness/client-store": "workspace:^",
    "@lyness/system-prompt": "workspace:^",
    "@lyness/tools": "workspace:^",
    "@lyness/user-questions": "workspace:^",
    "@types/react": "~18.3.1",
    "@lyness/client-ui-primitives": "workspace:^",
    "@lyness/client-ui-slots": "workspace:^",
    "@lyness/client-ui-renderer": "workspace:^",
    "@lyness/client-ui-session": "workspace:^",
    "@lyness/typert-protocol": "workspace:^",
    "react": "^18.2.0",
    "@lyness/client-ui-conversation": "workspace:^",
    "@lyness/client-connection": "workspace:^",
    "@lyness/session": "workspace:^",
    "clsx": "^2.0.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
