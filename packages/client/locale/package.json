{
  "name": "@lyness/client-locale",
  "description": "Locale plugin: Host-backed preference, extensible language catalog, browser fallback, and typed built-in dictionaries",
  "version": "0.1.2-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/client/locale"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "lyn": {
    "client": {
      "inject": [
        "@lyness/client-connection",
        "@lyness/client-ui-renderer",
        "@lyness/client-ui-settings",
        "@lyness/api-remotes"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@lyness/cordis": "workspace:^",
    "@lyness/api-remotes": "workspace:^",
    "@lyness/client-connection": "workspace:^",
    "@lyness/client-ui-renderer": "workspace:^",
    "@lyness/client-ui-settings": "workspace:^",
    "@lyness/invariants": "workspace:^",
    "@lyness/settings": "workspace:^"
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:^",
    "@lyness/api-remotes": "workspace:^",
    "@lyness/client-store": "workspace:^",
    "@lyness/client-test-runtime": "workspace:^",
    "@lyness/client-ui-primitives": "workspace:^",
    "@lyness/client-ui-renderer": "workspace:^",
    "@lyness/client-ui-settings": "workspace:^",
    "@lyness/client-ui-slots": "workspace:^",
    "@lyness/invariants": "workspace:^",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "@lyness/client-connection": "workspace:^",
    "@lyness/settings": "workspace:^"
  },
  "dependencies": {
    "@lyness/schemastery": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  }
}
