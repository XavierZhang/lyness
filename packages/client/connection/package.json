{
  "name": "@lyness/client-connection",
  "description": "Authenticated RPC transport, generation lifecycle, and browser fixture",
  "version": "0.1.2-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/client/connection"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "lyn": {
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "dependencies": {
    "@lyness/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "peerDependencies": {
    "@lyness/cordis": "workspace:^",
    "@lyness/attachment": "workspace:^",
    "@lyness/commands": "workspace:^",
    "@lyness/credentials": "workspace:^",
    "@lyness/brand": "workspace:^",
    "@lyness/host-directory-picker": "workspace:^",
    "@lyness/host-webserver": "workspace:^",
    "@lyness/invariants": "workspace:^",
    "@lyness/llm": "workspace:^",
    "@lyness/session": "workspace:^",
    "@lyness/settings": "workspace:^",
    "@lyness/tool-todo": "workspace:^"
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:^",
    "@lyness/attachment": "workspace:^",
    "@lyness/commands": "workspace:^",
    "@lyness/credentials": "workspace:^",
    "@lyness/brand": "workspace:^",
    "@lyness/host-directory-picker": "workspace:^",
    "@lyness/host-webserver": "workspace:^",
    "@lyness/invariants": "workspace:^",
    "@lyness/llm": "workspace:^",
    "@lyness/session": "workspace:^",
    "@lyness/settings": "workspace:^",
    "@lyness/tool-todo": "workspace:^"
  }
}
