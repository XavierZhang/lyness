{
  "name": "@lyness/lyn-client-ui-join",
  "description": "The page an invited person opens: what the invitation admits them to, and the directories that redeem it",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/client/ui-join"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "lyn": {
    "client": {
      "inject": [
        "@lyness/lyn-client-locale",
        "@lyness/lyn-client-ui-renderer"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@lyness/cordis": "workspace:~"
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-api-identity-controller": "workspace:*",
    "@lyness/lyn-client-locale": "workspace:*",
    "@lyness/lyn-client-test-runtime": "workspace:*",
    "@lyness/lyn-client-ui-renderer": "workspace:*",
    "@lyness/lyn-client-ui-slots": "workspace:*",
    "@lyness/lyn-client-ui-viewer": "workspace:*",
    "@lyness/schemastery": "workspace:~",
    "react": "^18.2.0"
  }
}
