{
  "name": "@lyness/lyn-client-ui-account-notifications",
  "description": "Display account notifications and refresh localized content",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/client/ui-account-notifications"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "lyn": {
    "client": {
      "inject": [
        "@lyness/lyn-api-remotes",
        "@lyness/lyn-client-locale",
        "@lyness/lyn-client-ui-settings-account"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@lyness/cordis": "workspace:~"
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-api-remotes": "workspace:*",
    "@lyness/lyn-client-locale": "workspace:*",
    "@lyness/lyn-client-test-runtime": "workspace:*",
    "@lyness/lyn-client-ui-primitives": "workspace:*",
    "@lyness/lyn-client-ui-slots": "workspace:*",
    "@lyness/lyn-deepseek-account": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@lyness/lyn-host-webserver": "workspace:*",
    "@lyness/lyn-client-ui-settings-account": "workspace:*",
    "@lyness/lyn-client-ui-renderer": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "dependencies": {
    "@lyness/schemastery": "workspace:~"
  }
}
