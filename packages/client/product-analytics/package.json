{
  "name": "@lyness/lyn-client-product-analytics",
  "description": "Desktop product event collection and authenticated Host reporting",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/client/product-analytics"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./types": {
      "types": "./lib/types/events.d.ts"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "lyn": {
    "client": {
      "inject": [
        "@lyness/lyn-api-gateway"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@lyness/cordis": "workspace:~"
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/cordis-plugin-loader": "workspace:~",
    "@lyness/lyn-api-gateway": "workspace:*",
    "@lyness/lyn-app-boot": "workspace:*",
    "@lyness/lyn-compaction": "workspace:*",
    "@lyness/lyn-deepseek-account": "workspace:*",
    "@lyness/lyn-host-product-telemetry-otel": "workspace:*",
    "@lyness/lyn-host-webserver": "workspace:*",
    "@lyness/lyn-llm": "workspace:*",
    "@lyness/lyn-loader-smoke": "workspace:*",
    "@lyness/lyn-otel": "workspace:*",
    "@lyness/lyn-session": "workspace:*",
    "@lyness/lyn-settings": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "dependencies": {
    "@lyness/lyn-typert-protocol": "workspace:*",
    "@lyness/schemastery": "workspace:~",
    "zod": "4.4.3"
  }
}
