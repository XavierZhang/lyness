{
  "name": "@lyness/client-ui-conversation",
  "description": "Target-neutral Conversation assembly, shell, composer, queue, and view navigation",
  "version": "0.1.5-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/client/ui-conversation"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "lyn": {
    "client": {
      "inject": [
        "@lyness/api-session-controller",
        "@lyness/client-file-upload",
        "@lyness/client-locale",
        "@lyness/client-ui-layout",
        "@lyness/client-ui-renderer",
        "@lyness/client-ui-session",
        "@lyness/client-ui-settings",
        "@lyness/client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "@lyness/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@lyness/cordis": "workspace:^"
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:^",
    "@lyness/api-remotes": "workspace:^",
    "@lyness/api-session-controller": "workspace:^",
    "@lyness/api-workspace-controller": "workspace:^",
    "@lyness/attachment": "workspace:^",
    "@lyness/brand": "workspace:^",
    "@lyness/client-locale": "workspace:^",
    "@lyness/client-file-upload": "workspace:^",
    "@lyness/client-store": "workspace:^",
    "@lyness/client-test-runtime": "workspace:^",
    "@lyness/client-ui-layout": "workspace:^",
    "@lyness/client-ui-primitives": "workspace:^",
    "@lyness/client-ui-renderer": "workspace:^",
    "@lyness/client-ui-session": "workspace:^",
    "@lyness/client-ui-settings": "workspace:^",
    "@lyness/client-ui-workspace": "workspace:^",
    "@lyness/client-ui-slots": "workspace:^",
    "@lyness/commands": "workspace:^",
    "@lyness/goal": "workspace:^",
    "@lyness/llm": "workspace:^",
    "@lyness/llm-retry": "workspace:^",
    "@lyness/permission-presets": "workspace:^",
    "@lyness/plan-mode": "workspace:^",
    "@lyness/session": "workspace:^",
    "@lyness/token-meter": "workspace:^",
    "@lyness/tool-todo": "workspace:^",
    "@lyness/util-crypto": "workspace:^",
    "@lyness/workspace": "workspace:^",
    "@lyness/util-workspace-path": "workspace:^",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "@lexical/headless": "^0.49.0",
    "react-dom": "^18.2.0",
    "@types/react-dom": "~18.3.0",
    "zod": "^4.4.3",
    "@lyness/settings": "workspace:^",
    "lexical": "^0.49.0",
    "clsx": "^2.0.0",
    "@lexical/utils": "^0.49.0",
    "@lexical/text": "^0.49.0",
    "@lexical/plain-text": "^0.49.0",
    "@lexical/history": "^0.49.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
