{
  "name": "@lyness/lyn-client-ui-sign-in",
  "description": "The sign-in screen a deployment with accounts shows, and the row naming who is signed in",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/client/ui-sign-in"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "lyn": {
    "client": {
      "inject": [
        "@lyness/lyn-client-locale",
        "@lyness/lyn-client-ui-layout",
        "@lyness/lyn-client-ui-renderer",
        "@lyness/lyn-client-ui-settings",
        "@lyness/lyn-client-ui-viewer"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@lyness/cordis": "workspace:~"
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-api-identity-controller": "workspace:*",
    "@lyness/lyn-client-locale": "workspace:*",
    "@lyness/lyn-client-test-runtime": "workspace:*",
    "@lyness/lyn-client-ui-layout": "workspace:*",
    "@lyness/lyn-client-ui-primitives": "workspace:*",
    "@lyness/lyn-client-ui-renderer": "workspace:*",
    "@lyness/lyn-client-ui-settings": "workspace:*",
    "@lyness/lyn-client-ui-slots": "workspace:*",
    "@lyness/lyn-client-ui-viewer": "workspace:*",
    "react": "^18.2.0"
  }
}
