{
  "name": "@lyness/lyn-skill-filesystem",
  "description": "Local filesystem skill provider for the lyness",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/skill/skill-filesystem"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@lyness/lyn-fs": "workspace:*",
    "@lyness/lyn-home-paths": "workspace:*",
    "@lyness/lyn-skill": "workspace:*",
    "@lyness/cordis": "workspace:~"
  },
  "dependencies": {
    "chokidar": "5.0.0",
    "@lyness/schemastery": "workspace:~",
    "yaml": "^2.4.2"
  },
  "devDependencies": {
    "@lyness/lyn-brand": "workspace:*",
    "@lyness/lyn-fs": "workspace:*",
    "@lyness/lyn-home-paths": "workspace:*",
    "@lyness/lyn-skill": "workspace:*",
    "@lyness/cordis": "workspace:~"
  }
}
