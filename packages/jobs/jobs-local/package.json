{
  "name": "@lyness/lyn-jobs-local",
  "description": "Process-local implementation of the lyness background job registry seam",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/jobs/jobs-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@lyness/lyn-agent": "workspace:*",
    "@lyness/lyn-scope": "workspace:*",
    "@lyness/lyn-jobs": "workspace:*",
    "@lyness/lyn-timeout": "workspace:*",
    "@lyness/cordis": "workspace:~"
  },
  "dependencies": {
    "@lyness/lyn-brand": "workspace:*",
    "@lyness/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@lyness/cordis-plugin-include": "workspace:~",
    "@lyness/cordis-plugin-loader": "workspace:~",
    "@lyness/lyn-agent": "workspace:*",
    "@lyness/lyn-agent-loop-testkit": "workspace:*",
    "@lyness/lyn-scope": "workspace:*",
    "@lyness/lyn-session": "workspace:*",
    "@lyness/lyn-jobs": "workspace:*",
    "@lyness/lyn-timeout": "workspace:*",
    "@lyness/cordis": "workspace:~"
  }
}
