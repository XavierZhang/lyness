{
  "name": "@lyness/lyn-agent-preset-registry",
  "description": "Declarative Agent preset registry and profile-backed editing",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/preset/agent-preset-registry"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./display": {
      "types": "./lib/types/display.d.ts",
      "default": "./lib/types/display.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@lyness/cordis-plugin-include": "workspace:~",
    "@lyness/cordis-plugin-loader": "workspace:~",
    "@lyness/lyn-agent": "workspace:*",
    "@lyness/lyn-invariants": "workspace:*",
    "@lyness/lyn-scope": "workspace:*",
    "@lyness/lyn-session": "workspace:*",
    "@lyness/lyn-session-projection": "workspace:*",
    "@lyness/lyn-settings": "workspace:*",
    "@lyness/lyn-system-prompt": "workspace:*",
    "@lyness/lyn-tools": "workspace:*",
    "@lyness/lyn-typert-protocol": "workspace:*",
    "@lyness/cordis": "workspace:~"
  },
  "dependencies": {
    "@lyness/lyn-app-boot": "workspace:*",
    "@lyness/schemastery": "workspace:~",
    "zod": "^4.4.3",
    "js-yaml": "^4.2.0"
  },
  "devDependencies": {
    "@lyness/cordis-plugin-group": "workspace:~",
    "@lyness/cordis-plugin-include": "workspace:~",
    "@lyness/cordis-plugin-loader": "workspace:~",
    "@lyness/lyn-agent": "workspace:*",
    "@lyness/lyn-agent-loop": "workspace:*",
    "@lyness/lyn-atomic-write": "workspace:*",
    "@lyness/lyn-invariants": "workspace:*",
    "@lyness/lyn-llm": "workspace:*",
    "@lyness/lyn-scope": "workspace:*",
    "@lyness/lyn-session": "workspace:*",
    "@lyness/lyn-session-projection": "workspace:*",
    "@lyness/lyn-settings": "workspace:*",
    "@lyness/lyn-system-prompt": "workspace:*",
    "@lyness/lyn-tools": "workspace:*",
    "@lyness/lyn-typert-protocol": "workspace:*",
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-hmr": "workspace:*",
    "@lyness/lyn-sandbox": "workspace:*",
    "@lyness/lyn-sandbox-policy": "workspace:*",
    "@lyness/lyn-user-approval": "workspace:*",
    "@lyness/lyn-agent-preset": "workspace:*",
    "@types/js-yaml": "^4.0.9"
  }
}
