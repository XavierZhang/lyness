{
  "name": "@lyness/agent-presets",
  "description": "Per-session agent composition from preset cordis.yml files for the lyness",
  "version": "0.1.2-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/preset/agent-presets"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "presets",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@lyness/cordis-plugin-include": "workspace:^",
    "@lyness/cordis-plugin-loader": "workspace:^",
    "@lyness/agent": "workspace:^",
    "@lyness/atomic-write": "workspace:^",
    "@lyness/invariants": "workspace:^",
    "@lyness/home-paths": "workspace:^",
    "@lyness/scope": "workspace:^",
    "@lyness/session": "workspace:^",
    "@lyness/session-projection": "workspace:^",
    "@lyness/settings": "workspace:^",
    "@lyness/system-prompt": "workspace:^",
    "@lyness/tools": "workspace:^",
    "@lyness/typert-protocol": "workspace:^",
    "@lyness/cordis": "workspace:^"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "@lyness/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@lyness/cordis-plugin-group": "workspace:^",
    "@lyness/cordis-plugin-include": "workspace:^",
    "@lyness/cordis-plugin-loader": "workspace:^",
    "@lyness/agent": "workspace:^",
    "@lyness/agent-loop": "workspace:^",
    "@lyness/atomic-write": "workspace:^",
    "@lyness/invariants": "workspace:^",
    "@lyness/llm": "workspace:^",
    "@lyness/home-paths": "workspace:^",
    "@lyness/scope": "workspace:^",
    "@lyness/session": "workspace:^",
    "@lyness/session-projection": "workspace:^",
    "@lyness/settings": "workspace:^",
    "@lyness/settings-file": "workspace:^",
    "@lyness/system-prompt": "workspace:^",
    "@lyness/tools": "workspace:^",
    "@lyness/typert-protocol": "workspace:^",
    "@lyness/cordis": "workspace:^"
  }
}
