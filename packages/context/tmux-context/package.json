    "@lyness/invariants": "workspace:^",
    "@lyness/session": "workspace:^",
    "@lyness/cordis": "workspace:^"
  },
  "devDependencies": {
    "@lyness/agent": "workspace:^",
    "@lyness/shell": "workspace:^",
    "@lyness/invariants": "workspace:^",
    "@lyness/llm": "workspace:^",
    "@lyness/session": "workspace:^",
    "@lyness/system-prompt": "workspace:^",
    "@lyness/cordis": "workspace:^"
  }
