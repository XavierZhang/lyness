{
  "name": "@lyness/session-reference",
  "description": "Cross-session snapshot references and durable untrusted model context (ctx.sessionReferenceResolver)",
  "version": "0.1.5-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/context/session-reference"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@lyness/brand": "workspace:^",
    "@lyness/util-values": "workspace:^",
    "@lyness/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@lyness/cordis": "workspace:^",
    "@lyness/agent": "workspace:^",
    "@lyness/compaction": "workspace:^",
    "@lyness/llm": "workspace:^",
    "@lyness/output-retention": "workspace:^",
    "@lyness/session": "workspace:^",
    "@lyness/session-projection": "workspace:^",
    "@lyness/session-projection-cache": "workspace:^",
    "@lyness/session-query": "workspace:^",
    "@lyness/session-title": "workspace:^",
    "@lyness/spill": "workspace:^",
    "@lyness/system-prompt": "workspace:^",
    "@lyness/typert-protocol": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@lyness/spill": {
      "optional": true
    },
    "@lyness/session-projection-cache": {
      "optional": true
    }
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:^",
    "@lyness/cordis-plugin-include": "workspace:^",
    "@lyness/cordis-plugin-loader": "workspace:^",
    "@lyness/agent": "workspace:^",
    "@lyness/compaction": "workspace:^",
    "@lyness/fs-local": "workspace:^",
    "@lyness/llm": "workspace:^",
    "@lyness/output-retention": "workspace:^",
    "@lyness/session": "workspace:^",
    "@lyness/session-projection": "workspace:^",
    "@lyness/session-projection-cache": "workspace:^",
    "@lyness/session-query": "workspace:^",
    "@lyness/session-query-sqlite": "workspace:^",
    "@lyness/session-title": "workspace:^",
    "@lyness/spill": "workspace:^",
    "@lyness/spill-local": "workspace:^",
    "@lyness/system-prompt": "workspace:^",
    "@lyness/tool-fs": "workspace:^",
    "@lyness/tools": "workspace:^",
    "@lyness/typert-protocol": "workspace:^"
  }
}
