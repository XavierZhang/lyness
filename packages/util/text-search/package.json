{
  "name": "@lyness/lyn-util-text-search",
  "description": "Multilingual fuzzy filtering for in-memory search lists",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/util/text-search"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@lyness/lyn-package-manifest": "workspace:*",
    "fuzzysort": "4.0.2"
  },
  "peerDependencies": {
    "@lyness/cordis": "workspace:~"
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:~"
  }
}
