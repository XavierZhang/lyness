    "@deepseek-ai/dsh-storage-domain": "workspace:*",
    "@deepseek-ai/dsh-util-crypto": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-request-principal": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-admin-audit": "workspace:*",
    "@deepseek-ai/dsh-brand": "workspace:*",
    "@deepseek-ai/dsh-people": "workspace:*",
    "@deepseek-ai/dsh-storage-domain": "workspace:*",
    "@deepseek-ai/dsh-util-crypto": "workspace:*",
    "@deepseek-ai/dsh-storage": "workspace:*",
    "@deepseek-ai/dsh-storage-json": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-request-principal": "workspace:*",
    "@deepseek-ai/dsh-auth-session": "workspace:*",
    "@deepseek-ai/dsh-client-connection": "workspace:*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~",
