      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./period": {
      "types": "./lib/types/period.d.ts",
      "default": "./lib/types/period.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./store": {
      "types": "./lib/types/store.d.ts",
      "default": "./lib/types/store.js"
    },
    "./storage": {
      "types": "./lib/types/storage.d.ts",
      "default": "./lib/types/storage.js"
    },
    "./subject": {
      "types": "./lib/types/subject.d.ts",
      "default": "./lib/types/subject.js"
    },
    "./pricing": {
      "types": "./lib/types/pricing.d.ts",
      "default": "./lib/types/pricing.js"
    },
    "./enforce": {
      "types": "./lib/types/enforce.d.ts",
      "default": "./lib/types/enforce.js"
    },
    "./subject-request": {
      "types": "./lib/types/subject-request.d.ts",
      "default": "./lib/types/subject-request.js"
    },
    "./allowance": {
      "types": "./lib/types/allowance.d.ts",
      "default": "./lib/types/allowance.js"
    },
    "./allowance-storage": {
      "types": "./lib/types/allowance-storage.d.ts",
      "default": "./lib/types/allowance-storage.js"
    },
    "./administration": {
      "types": "./lib/types/administration.d.ts",
      "default": "./lib/types/administration.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
