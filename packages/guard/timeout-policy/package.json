{
  "name": "@lyness/lyn-tool-call-timeout-policy",
  "description": "Tool-call timeout policy: a tools/execute wrapper that arms a per-tool deadline on exec.signal and returns TOOL_TIMEOUT when it wins",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/guard/timeout-policy"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-llm": "workspace:*",
    "@lyness/lyn-timeout": "workspace:*",
    "@lyness/lyn-tools": "workspace:*"
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-llm": "workspace:*",
    "@lyness/lyn-timeout": "workspace:*",
    "@lyness/lyn-tool-executor-native": "workspace:*",
    "@lyness/lyn-tool-testkit": "workspace:*",
    "@lyness/lyn-tools": "workspace:*"
  }
}
