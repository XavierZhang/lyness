{
  "name": "@deepseek-ai/dsh-api-tenant-controller",
  "description": "Remote owner of the tenant-configuration surface: the calling tenant reads and saves its own configuration",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/api/tenant-controller"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-credentials": "workspace:*",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-tenant": "workspace:*",
    "@deepseek-ai/dsh-tenant-config": "workspace:*",
    "@deepseek-ai/dsh-tenant-request": "workspace:*",
    "@deepseek-ai/dsh-typert-protocol": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-client-connection": "workspace:*",
    "@deepseek-ai/dsh-storage": "workspace:*",
    "@deepseek-ai/dsh-storage-domain": "workspace:*",
    "@deepseek-ai/dsh-storage-json": "workspace:*",
    "@deepseek-ai/dsh-tenant": "workspace:*",
    "@deepseek-ai/dsh-tenant-config": "workspace:*",
    "@deepseek-ai/dsh-tenant-config-static": "workspace:*",
    "@deepseek-ai/dsh-tenant-config-store": "workspace:*",
    "@deepseek-ai/dsh-tenant-request": "workspace:*",
    "@deepseek-ai/dsh-tenant-static": "workspace:*",
    "@deepseek-ai/dsh-typert-protocol": "workspace:*"
  }
}
