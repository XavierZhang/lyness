{
  "name": "@lyness/lyn-api-session-controller",
  "description": "Session Remote commands, cold reads, and live control transport",
  "version": "0.1.5-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/api/session-controller"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./remote-events": {
      "types": "./lib/types/remote-events.d.ts",
      "default": "./lib/types/remote-events.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "lyn": {
    "client": {
      "external": [
        "@lyness/lyn-api-gateway/client"
      ],
      "inject": [
        "@lyness/lyn-api-gateway"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@lyness/lyn-brand": "workspace:^",
    "@lyness/lyn-deque": "workspace:^",
    "@lyness/schemastery": "workspace:^",
    "mime-types": "^3.0.2",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@lyness/cordis": "workspace:^",
    "@lyness/lyn-agent": "workspace:^",
    "@lyness/lyn-agent-default-model": "workspace:^",
    "@lyness/lyn-agent-presets": "workspace:^",
    "@lyness/lyn-api-gateway": "workspace:^",
    "@lyness/lyn-attachment": "workspace:^",
    "@lyness/lyn-client-connection": "workspace:^",
    "@lyness/lyn-client-file-upload": "workspace:^",
    "@lyness/lyn-commands": "workspace:^",
    "@lyness/lyn-file-reference": "workspace:^",
    "@lyness/lyn-fs": "workspace:^",
    "@lyness/lyn-jobs": "workspace:^",
    "@lyness/lyn-llm": "workspace:^",
    "@lyness/lyn-native-command": "workspace:^",
    "@lyness/lyn-scope": "workspace:^",
    "@lyness/lyn-session": "workspace:^",
    "@lyness/lyn-session-persistence": "workspace:^",
    "@lyness/lyn-session-projection": "workspace:^",
    "@lyness/lyn-session-projection-cache": "workspace:^",
    "@lyness/lyn-session-query": "workspace:^",
    "@lyness/lyn-session-title": "workspace:^",
    "@lyness/lyn-skill": "workspace:^",
    "@lyness/lyn-subagent": "workspace:^",
    "@lyness/lyn-typert-protocol": "workspace:^",
    "@lyness/lyn-typert-registry": "workspace:^",
    "@lyness/lyn-util-time": "workspace:^",
    "@lyness/lyn-util-values": "workspace:^",
    "@lyness/lyn-util-workspace-path": "workspace:^",
    "@lyness/lyn-workspace": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@lyness/lyn-jobs": {
      "optional": true
    },
    "@lyness/lyn-session-persistence": {
      "optional": true
    },
    "@lyness/lyn-session-projection-cache": {
      "optional": true
    }
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:^",
    "@lyness/lyn-agent": "workspace:^",
    "@lyness/lyn-agent-default-model": "workspace:^",
    "@lyness/lyn-agent-loop": "workspace:^",
    "@lyness/lyn-agent-loop-testkit": "workspace:^",
    "@lyness/lyn-agent-presets": "workspace:^",
    "@lyness/lyn-api-gateway": "workspace:^",
    "@lyness/lyn-attachment": "workspace:^",
    "@lyness/lyn-client-connection": "workspace:^",
    "@lyness/lyn-client-file-upload": "workspace:^",
    "@lyness/lyn-client-store": "workspace:^",
    "@lyness/lyn-commands": "workspace:^",
    "@lyness/lyn-file-reference": "workspace:^",
    "@lyness/lyn-fs": "workspace:^",
    "@lyness/lyn-fs-local": "workspace:^",
    "@lyness/lyn-jobs": "workspace:^",
    "@lyness/lyn-llm": "workspace:^",
    "@lyness/lyn-native-command": "workspace:^",
    "@lyness/lyn-permission-presets": "workspace:^",
    "@lyness/lyn-scope": "workspace:^",
    "@lyness/lyn-session": "workspace:^",
    "@lyness/lyn-session-persistence": "workspace:^",
    "@lyness/lyn-session-projection": "workspace:^",
    "@lyness/lyn-session-projection-cache": "workspace:^",
    "@lyness/lyn-session-query": "workspace:^",
    "@lyness/lyn-session-title": "workspace:^",
    "@lyness/lyn-skill": "workspace:^",
    "@lyness/lyn-storage": "workspace:^",
    "@lyness/lyn-storage-domain": "workspace:^",
    "@lyness/lyn-storage-json": "workspace:^",
    "@lyness/lyn-subagent": "workspace:^",
    "@lyness/lyn-typert-protocol": "workspace:^",
    "@lyness/lyn-typert-registry": "workspace:^",
    "@lyness/lyn-util-crypto": "workspace:^",
    "@lyness/lyn-util-time": "workspace:^",
    "@lyness/lyn-util-values": "workspace:^",
    "@lyness/lyn-util-workspace-path": "workspace:^",
    "@lyness/lyn-workspace": "workspace:^",
    "@types/mime-types": "^3.0.1"
  }
}
