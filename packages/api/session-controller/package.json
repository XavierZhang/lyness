{
  "name": "@lyness/api-session-controller",
  "description": "Session Remote commands, cold reads, and live control transport",
  "version": "0.1.2-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/api/session-controller"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./remote-events": {
      "types": "./lib/types/remote-events.d.ts",
      "default": "./lib/types/remote-events.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "lyn": {
    "client": {
      "external": [
        "@lyness/api-gateway/client"
      ],
      "inject": [
        "@lyness/api-gateway"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@lyness/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@lyness/cordis": "workspace:^",
    "@lyness/agent": "workspace:^",
    "@lyness/agent-default-model": "workspace:^",
    "@lyness/agent-presets": "workspace:^",
    "@lyness/api-gateway": "workspace:^",
    "@lyness/attachment": "workspace:^",
    "@lyness/brand": "workspace:^",
    "@lyness/client-connection": "workspace:^",
    "@lyness/file-reference": "workspace:^",
    "@lyness/invariants": "workspace:^",
    "@lyness/jobs": "workspace:^",
    "@lyness/llm": "workspace:^",
    "@lyness/native-command": "workspace:^",
    "@lyness/scope": "workspace:^",
    "@lyness/session": "workspace:^",
    "@lyness/session-persistence": "workspace:^",
    "@lyness/session-projection": "workspace:^",
    "@lyness/session-projection-cache": "workspace:^",
    "@lyness/session-query": "workspace:^",
    "@lyness/skill": "workspace:^",
    "@lyness/session-title": "workspace:^",
    "@lyness/subagent": "workspace:^",
    "@lyness/typert-protocol": "workspace:^",
    "@lyness/typert-registry": "workspace:^",
    "@lyness/workspace": "workspace:^",
    "@lyness/util-workspace-path": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@lyness/jobs": { "optional": true },
    "@lyness/session-persistence": { "optional": true },
    "@lyness/session-projection-cache": { "optional": true }
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:^",
    "@lyness/agent": "workspace:^",
    "@lyness/agent-default-model": "workspace:^",
    "@lyness/agent-presets": "workspace:^",
    "@lyness/api-gateway": "workspace:^",
    "@lyness/attachment": "workspace:^",
    "@lyness/brand": "workspace:^",
    "@lyness/client-connection": "workspace:^",
    "@lyness/client-store": "workspace:^",
    "@lyness/file-reference": "workspace:^",
    "@lyness/invariants": "workspace:^",
    "@lyness/jobs": "workspace:^",
    "@lyness/llm": "workspace:^",
    "@lyness/native-command": "workspace:^",
    "@lyness/permission-presets": "workspace:^",
    "@lyness/scope": "workspace:^",
    "@lyness/session": "workspace:^",
    "@lyness/session-persistence": "workspace:^",
    "@lyness/session-projection": "workspace:^",
    "@lyness/session-projection-cache": "workspace:^",
    "@lyness/session-query": "workspace:^",
    "@lyness/skill": "workspace:^",
    "@lyness/session-title": "workspace:^",
    "@lyness/subagent": "workspace:^",
    "@lyness/typert-protocol": "workspace:^",
    "@lyness/typert-registry": "workspace:^",
    "@lyness/util-crypto": "workspace:^",
    "@lyness/workspace": "workspace:^",
    "@lyness/util-workspace-path": "workspace:^"
  }
}
