{
  "name": "@lyness/lyn-api-remotes",
  "description": "Remote BFF assembly for application-selected Host capabilities",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/api/remotes"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "lyn": {
    "client": {
      "inject": [
        "@lyness/lyn-api-gateway"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@lyness/lyn-deque": "workspace:*",
    "@lyness/lyn-session": "workspace:*",
    "@lyness/lyn-util-values": "workspace:*"
  },
  "peerDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-scope": "workspace:*"
  },
  "devDependencies": {
    "@lyness/lyn-agent": "workspace:*",
    "@lyness/lyn-agent-preset-registry": "workspace:*",
    "@lyness/lyn-api-gateway": "workspace:*",
    "@lyness/lyn-api-job-controller": "workspace:*",
    "@lyness/lyn-api-session-controller": "workspace:*",
    "@lyness/lyn-api-settings-controller": "workspace:*",
    "@lyness/lyn-api-workspace-controller": "workspace:*",
    "@lyness/lyn-api-workspace-files": "workspace:*",
    "@lyness/lyn-client-connection": "workspace:*",
    "@lyness/lyn-client-file-upload": "workspace:*",
    "@lyness/lyn-commands": "workspace:*",
    "@lyness/lyn-cordis-host-runner": "workspace:*",
    "@lyness/lyn-credentials": "workspace:*",
    "@lyness/lyn-file-reference": "workspace:*",
    "@lyness/lyn-goal": "workspace:*",
    "@lyness/lyn-host-plugin-inventory": "workspace:*",
    "@lyness/lyn-llm": "workspace:*",
    "@lyness/lyn-message-feedback": "workspace:*",
    "@lyness/lyn-permission-presets": "workspace:*",
    "@lyness/lyn-schedule": "workspace:*",
    "@lyness/lyn-scope": "workspace:*",
    "@lyness/lyn-session-reference": "workspace:*",
    "@lyness/lyn-settings": "workspace:*",
    "@lyness/lyn-subagent": "workspace:*",
    "@lyness/lyn-typert-protocol": "workspace:*",
    "@lyness/lyn-user-approval": "workspace:*",
    "@lyness/lyn-user-questions": "workspace:*",
    "@lyness/cordis": "workspace:~",
    "zod": "^4.4.3",
    "@lyness/lyn-command-feedback": "workspace:*",
    "@lyness/lyn-api-terminal-controller": "workspace:*",
    "@lyness/lyn-plugin-manager": "workspace:*",
    "@lyness/lyn-client-ui-plugin-manager": "workspace:*",
    "@lyness/lyn-office-to-pdf": "workspace:*",
    "@lyness/lyn-api-account-controller": "workspace:*",
    "@lyness/lyn-deepseek-account": "workspace:*"
  }
}
