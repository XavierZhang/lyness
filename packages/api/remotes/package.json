{
  "name": "@lyness/api-remotes",
  "description": "Remote BFF assembly for application-selected Host capabilities",
  "version": "0.1.5-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/api/remotes"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "lyn": {
    "client": {
      "inject": [
        "@lyness/api-gateway"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@lyness/deque": "workspace:^",
    "@lyness/session": "workspace:^",
    "@lyness/util-values": "workspace:^"
  },
  "peerDependencies": {
    "@lyness/cordis": "workspace:^",
    "@lyness/scope": "workspace:^"
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:^",
    "@lyness/agent": "workspace:^",
    "@lyness/agent-presets": "workspace:^",
    "@lyness/api-gateway": "workspace:^",
    "@lyness/api-settings-controller": "workspace:^",
    "@lyness/api-workspace-controller": "workspace:^",
    "@lyness/commands": "workspace:^",
    "@lyness/cordis-host-runner": "workspace:^",
    "@lyness/credentials": "workspace:^",
    "@lyness/file-reference": "workspace:^",
    "@lyness/goal": "workspace:^",
    "@lyness/host-plugin-inventory": "workspace:^",
    "@lyness/llm": "workspace:^",
    "@lyness/message-feedback": "workspace:^",
    "@lyness/session-reference": "workspace:^",
    "@lyness/settings": "workspace:^",
    "@lyness/subagent": "workspace:^",
    "@lyness/user-approval": "workspace:^",
    "@lyness/user-questions": "workspace:^",
    "@lyness/client-connection": "workspace:^",
    "@lyness/client-file-upload": "workspace:^",
    "@lyness/typert-protocol": "workspace:^",
    "@lyness/scope": "workspace:^",
    "@lyness/api-session-controller": "workspace:^",
    "@lyness/api-workspace-files": "workspace:^",
    "zod": "^4.4.3",
    "@lyness/command-feedback": "workspace:^"
  }
}
