{
  "name": "@lyness/lyn-cordis-client-runner",
  "description": "Browser half of dynamic dual-half plugin packages: event subscription, closure evaluation, guard facade, and loader entries",
  "version": "0.1.5-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/extensions/cordis-client-runner"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "lyn": {
    "client": {
      "inject": [
        "@lyness/lyn-client-ui-renderer",
        "@lyness/lyn-api-remotes",
        "@lyness/lyn-client-modules",
        "@lyness/lyn-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@lyness/cordis": "workspace:^"
  },
  "devDependencies": {
    "@lyness/cordis-plugin-loader": "workspace:^",
    "@lyness/lyn-api-remotes": "workspace:^",
    "@lyness/lyn-client-modules": "workspace:^",
    "@lyness/lyn-client-ui-renderer": "workspace:^",
    "@lyness/lyn-client-ui-theme": "workspace:^",
    "@types/react": "~18.3.1",
    "@lyness/cordis": "workspace:^",
    "react": "^18.2.0",
    "@lyness/lyn-util-values": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
