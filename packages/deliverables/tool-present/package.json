{
  "name": "@lyness/lyn-tool-present",
  "description": "Explicit workspace file delivery declarations for the lyness",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/deliverables/tool-present"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./preset-contribution": {
      "types": "./lib/types/preset-contribution.d.ts",
      "default": "./lib/types/preset-contribution.js"
    }
  },
  "license": "MIT",
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@lyness/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-agent": "workspace:*",
    "@lyness/lyn-agent-preset-registry": "workspace:*",
    "@lyness/lyn-fs": "workspace:*",
    "@lyness/lyn-llm": "workspace:*",
    "@lyness/lyn-session": "workspace:*",
    "@lyness/lyn-session-projection": "workspace:*",
    "@lyness/lyn-tools": "workspace:*",
    "@lyness/lyn-working-directory": "workspace:*"
  },
  "devDependencies": {
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-agent": "workspace:*",
    "@lyness/lyn-agent-loop": "workspace:*",
    "@lyness/lyn-agent-loop-testkit": "workspace:*",
    "@lyness/lyn-agent-preset-registry": "workspace:*",
    "@lyness/lyn-fs": "workspace:*",
    "@lyness/lyn-fs-local": "workspace:*",
    "@lyness/lyn-llm": "workspace:*",
    "@lyness/lyn-scope": "workspace:*",
    "@lyness/lyn-session": "workspace:*",
    "@lyness/lyn-session-projection": "workspace:*",
    "@lyness/lyn-system-prompt": "workspace:*",
    "@lyness/lyn-tool-executor-native": "workspace:*",
    "@lyness/lyn-tool-testkit": "workspace:*",
    "@lyness/lyn-tools": "workspace:*",
    "@lyness/lyn-working-directory": "workspace:*"
  }
}
