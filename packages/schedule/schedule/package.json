{
  "name": "@lyness/lyn-schedule",
  "description": "Host-wide durable reminders with shared management and delivery to existing or new Sessions",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierZhang/lyness.git",
    "directory": "packages/schedule/schedule"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    }
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/typert.remote-client.d.ts.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@lyness/lyn-agent": "workspace:*",
    "@lyness/lyn-api-session-controller": "workspace:*",
    "@lyness/lyn-llm": "workspace:*",
    "@lyness/lyn-session": "workspace:*",
    "@lyness/lyn-session-persistence": "workspace:*",
    "@lyness/lyn-session-projection": "workspace:*",
    "@lyness/lyn-storage-domain": "workspace:*",
    "@lyness/lyn-subagent": "workspace:*",
    "@lyness/lyn-tools": "workspace:*",
    "@lyness/lyn-typert-protocol": "workspace:*",
    "@lyness/lyn-util-time": "workspace:*",
    "@lyness/lyn-workspace": "workspace:*",
    "@lyness/cordis": "workspace:~"
  },
  "dependencies": {
    "@lyness/lyn-brand": "workspace:*",
    "@lyness/schemastery": "workspace:~",
    "@js-temporal/polyfill": "0.5.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@lyness/cordis-plugin-loader": "workspace:~",
    "@lyness/lyn-agent": "workspace:*",
    "@lyness/lyn-agent-loop": "workspace:*",
    "@lyness/lyn-agent-loop-testkit": "workspace:*",
    "@lyness/lyn-api-session-controller": "workspace:*",
    "@lyness/lyn-llm": "workspace:*",
    "@lyness/lyn-session": "workspace:*",
    "@lyness/lyn-session-persistence": "workspace:*",
    "@lyness/lyn-session-persistence-jsonl": "workspace:*",
    "@lyness/lyn-session-projection": "workspace:*",
    "@lyness/lyn-session-title": "workspace:*",
    "@lyness/lyn-storage": "workspace:*",
    "@lyness/lyn-storage-domain": "workspace:*",
    "@lyness/lyn-storage-json": "workspace:*",
    "@lyness/lyn-subagent": "workspace:*",
    "@lyness/lyn-system-prompt": "workspace:*",
    "@lyness/lyn-tool-executor-native": "workspace:*",
    "@lyness/lyn-tools": "workspace:*",
    "@lyness/lyn-typert-protocol": "workspace:*",
    "@lyness/lyn-util-time": "workspace:*",
    "@lyness/lyn-workspace": "workspace:*",
    "@lyness/cordis": "workspace:~",
    "@lyness/lyn-goal": "workspace:*",
    "@lyness/lyn-goal-round-driver": "workspace:*"
  }
}
